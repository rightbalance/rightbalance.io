llment process by transforming the way researchers identify eligible patients. Using artificial intelligence and natural language processing to mine structured and unstructured patient data, we find more, better-matching patients for trials in minutes, not months.",{"type":111,"tag":120,"props":667,"children":668},{},[669],{"type":117,"value":670},"They work with some of the most prominent health systems, pharma companies, and CROs in the world, making our platform a crucial step in their clinical research workflow and greatly accelerating patients’ access to clinical trials.",{"type":111,"tag":120,"props":672,"children":673},{},[674],{"type":117,"value":386},{"type":111,"tag":120,"props":676,"children":677},{},[678],{"type":117,"value":391},{"type":111,"tag":142,"props":680,"children":681},{},[682,687,692,697,702,707,712,716],{"type":111,"tag":146,"props":683,"children":684},{},[685],{"type":117,"value":686},"Collaborate with cross-functional teams including medical oncologists, research scientists, and engineers to develop and maintain clinical data models.",{"type":111,"tag":146,"props":688,"children":689},{},[690],{"type":117,"value":691},"Translate customer needs and product requests into key concept definitions and business logic for complex models.",{"type":111,"tag":146,"props":693,"children":694},{},[695],{"type":117,"value":696},"Facilitate integration of data model into workflows, applications, and data deliveries.",{"type":111,"tag":146,"props":698,"children":699},{},[700],{"type":117,"value":701},"Structure and normalize data from a variety of sources, including internal curated data, EHR integrations, and lab systems.",{"type":111,"tag":146,"props":703,"children":704},{},[705],{"type":117,"value":706},"Develop and maintain knowledge bases for clinical concepts.",{"type":111,"tag":146,"props":708,"children":709},{},[710],{"type":117,"value":711},"Create and execute validation plans in conjunction with SMEs for new models and disease types.",{"type":111,"tag":146,"props":713,"children":714},{},[715],{"type":117,"value":419},{"type":111,"tag":146,"props":717,"children":718},{},[719],{"type":117,"value":424},{"type":111,"tag":120,"props":721,"children":722},{},[723],{"type":117,"value":429},{"type":111,"tag":142,"props":725,"children":726},{},[727],{"type":111,"tag":146,"props":728,"children":729},{},[730],{"type":117,"value":731},"6+ months contract (with option to extend).",{"type":111,"tag":112,"props":733,"children":734},{"id":153},[735],{"type":117,"value":156},{"type":111,"tag":158,"props":737,"children":738},{},[739,743,747,751],{"type":111,"tag":146,"props":740,"children":741},{},[742],{"type":117,"value":165},{"type":111,"tag":146,"props":744,"children":745},{},[746],{"type":117,"value":170},{"type":111,"tag":146,"props":748,"children":749},{},[750],{"type":117,"value":175},{"type":111,"tag":146,"props":752,"children":753},{},[754],{"type":117,"value":180},{"type":111,"tag":112,"props":756,"children":757},{"id":183},[758],{"type":117,"value":186},{"type":111,"tag":142,"props":760,"children":761},{},[762,766,771,776,781,786,791,796],{"type":111,"tag":146,"props":763,"children":764},{},[765],{"type":117,"value":194},{"type":111,"tag":146,"props":767,"children":768},{},[769],{"type":117,"value":770},"5+ years of full-time hands-on Data Engineer/Modeler experience.",{"type":111,"tag":146,"props":772,"children":773},{},[774],{"type":117,"value":775},"3+ years of full-time hands-on ELT tools/DBT experience.",{"type":111,"tag":146,"props":777,"children":778},{},[779],{"type":117,"value":780},"2+ years of full-time hands-on FHIR/OMOP experience.",{"type":111,"tag":146,"props":782,"children":783},{},[784],{"type":117,"value":785},"Background with EHR data and using it for secondary purposes, specifically experience with mapping data into OMOP or using Smart on FHIR apps.",{"type":111,"tag":146,"props":787,"children":788},{},[789],{"type":117,"value":790},"Experience working with real world data from various sources (e.g., curation workflows, EHRs, lab systems, claims, research datasets).",{"type":111,"tag":146,"props":792,"children":793},{},[794],{"type":117,"value":795},"Experience working with modern ELT tools such as DBT to maintain high volume, high velocity data warehouses",{"type":111,"tag":146,"props":797,"children":798},{},[799],{"type":117,"value":800},"Experience working with standard medical terminologies (e.g., SNOMED CT, RxNorm, LOINC, ICD-9/10).",{"type":111,"tag":112,"props":802,"children":803},{"id":227},[804],{"type":117,"value":230},{"type":111,"tag":142,"props":806,"children":807},{},[808,813,818,823,828],{"type":111,"tag":146,"props":809,"children":810},{},[811],{"type":117,"value":812},"Clinical background (MD/DO, PharmD, PA, NP, RN, etc.).",{"type":111,"tag":146,"props":814,"children":815},{},[816],{"type":117,"value":817},"Familiarity with next-generation sequencing data.",{"type":111,"tag":146,"props":819,"children":820},{},[821],{"type":117,"value":822},"Experience with real world data analysis in Python or R.",{"type":111,"tag":146,"props":824,"children":825},{},[826],{"type":117,"value":827},"Participation in professional organizations (e.g., OHDSI, AMIA).",{"type":111,"tag":146,"props":829,"children":830},{},[831],{"type":117,"value":238},{"type":111,"tag":112,"props":833,"children":834},{"id":241},[835],{"type":117,"value":244},{"type":111,"tag":246,"props":837,"children":838},{},[839],{"type":111,"tag":120,"props":840,"children":841},{},[842],{"type":111,"tag":253,"props":843,"children":844},{},[845],{"type":117,"value":257},{"type":111,"tag":120,"props":847,"children":848},{},[849],{"type":117,"value":262},{"type":111,"tag":246,"props":851,"children":852},{},[853],{"type":111,"tag":120,"props":854,"children":855},{},[856],{"type":111,"tag":253,"props":857,"children":858},{},[859],{"type":117,"value":273},{"type":111,"tag":120,"props":861,"children":862},{},[863],{"type":117,"value":278},{"type":111,"tag":246,"props":865,"children":866},{},[867],{"