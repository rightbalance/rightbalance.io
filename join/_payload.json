 Impact",[6],[],"No bureaucracy, deliver meaningful changes","speedometer",{"type":16,"children":61,"toc":62},[],{"title":8,"searchDepth":19,"depth":19,"links":63},[],"content:join:4_make-impact.md","join/4_make-impact.md",{"_path":67,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":68,"description":8,"tags":69,"related_content":70,"short_title":68,"header_one":68,"header_two":71,"icon":72,"body":73,"_type":21,"_id":77,"_source":23,"_file":78,"_extension":25},"/join/5_challenge","Challenge",[6],[],"the old beliefs with new technology","vector-intersection",{"type":16,"children":74,"toc":75},[],{"title":8,"searchDepth":19,"depth":19,"links":76},[],"content:join:5_challenge.md","join/5_challenge.md",{"_path":80,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":81,"description":8,"tags":82,"related_content":83,"short_title":81,"header_one":81,"header_two":84,"icon":85,"body":86,"_type":21,"_id":90,"_source":23,"_file":91,"_extension":25},"/join/6_recharge","Recharge",[6],[],"We pay vacations and local holidays","bag-carry-on",{"type":16,"children":87,"toc":88},[],{"title":8,"searchDepth":19,"depth":19,"links":89},[],"content:join:6_recharge.md","join/6_recharge.md",[93,352,589],{"_path":94,"_dir":95,"_draft":7,"_partial":7,"_locale":8,"title":96,"description":8,"draft":7,"tags":97,"related_content":99,"short_title":96,"header_one":100,"header_two":101,"header_three":8,"cta_header":102,"cta_button":103,"cta_href":104,"icon":8,"icons":105,"image_url":8,"hero_image":8,"body":108,"_type":21,"_id":350,"_source":23,"_file":351,"_extension":25},"/opportunities/ai-engineer-476","opportunities","AI-Native Software Engineer",[98],"oportunity",[],"AI-Native","Software Engineer","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrWu1M0aA9QTvTVF",[106,107],"account","language-typescript",{"type":16,"children":109,"toc":342},[110,119,125,131,136,161,166,172,196,202,225,231,244,250,263,268,279,284,295,300,311,316,327,332,337],{"type":111,"tag":112,"props":113,"children":115},"element","h2",{"id":114},"overview",[116],{"type":117,"value":118},"text","Overview",{"type":111,"tag":120,"props":121,"children":122},"p",{},[123],{"type":117,"value":124},"We're looking for a AI-Native Software Engineer. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":111,"tag":112,"props":126,"children":128},{"id":127},"client-engagement-details",[129],{"type":117,"value":130},"Client Engagement Details",{"type":111,"tag":120,"props":132,"children":133},{},[134],{"type":117,"value":135},"Our client operates in the healthcare space, pairing patients with dedicated Advocates to navigate mental health care alongside PCPs. They handle regulated data, so compliance and high quality are key.\nWe are seeking a strong technical leader to drive their engineering efforts. This role is ideal for a hands-on Mid-to-Senior Software Engineer.",{"type":111,"tag":137,"props":138,"children":139},"ul",{},[140,146,151,156],{"type":111,"tag":141,"props":142,"children":143},"li",{},[144],{"type":117,"value":145},"Develop, maintain, and optimize user-facing features and backend services using modern Web technologies.",{"type":111,"tag":141,"props":147,"children":148},{},[149],{"type":117,"value":150},"Leverage AI-native workflows day to day, utilizing coding agents and building/managing agentic harnesses (automated review, testing, and evaluation loops).",{"type":111,"tag":141,"props":152,"children":153},{},[154],{"type":117,"value":155},"Integrate systems securely while adhering to HIPAA guidelines and handling sensitive healthcare/regulated data.",{"type":111,"tag":141,"props":157,"children":158},{},[159],{"type":117,"value":160},"Collaborate asynchronously and synchronously with US-based engineering teams during US Eastern business hours.",{"type":111,"tag":120,"props":162,"children":163},{},[164],{"type":117,"value":165},"Availability: Part-time (20 hours per week).",{"type":111,"tag":112,"props":167,"children":169},{"id":168},"whats-in-it-for-you",[170],{"type":117,"value":171},"What’s in it for you",{"type":111,"tag":173,"props":174,"children":175},"ol",{},[176,181,186,191],{"type":111,"tag":141,"props":177,"children":178},{},[179],{"type":117,"value":180},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":111,"tag":141,"props":182,"children":183},{},[184],{"type":117,"value":185},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":111,"tag":141,"props":187,"children":188},{},[189],{"type":117,"value":190},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":111,"tag":141,"props":192,"children":193},{},[194],{"type":117,"value":195},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":111,"tag":112,"props":197,"children":199},{"id":198},"required-qualifications",[200],{"type":117,"value":201},"Required Qualifications",{"type":111,"tag":137,"props":203,"children":204},{},[205,210,215,220],{"type":111,"tag":141,"props":206,"children":207},{},[208],{"type":117,"value":209},"Upper-intermediate to fluent speaking and writing English. Able to have a real-time conversation.",{"type":111,"tag":141,"props":211,"children":212},{},[213],{"type":117,"value":214},"3+ years AI-Native Workflow: Daily experience working with AI coding agents and familiarity with agentic harnesses (eval loops, automated test/review).",{"type":111,"tag":141,"props":216,"children":217},{},[218],{"type":117,"value":219},"3+ years Tech Stack: Strong hands-on proficiency with TypeScript and React.",{"type":111,"tag":141,"props":221,"children":222},{},[223],{"type":117,"value":224},"Compliance & Security: Willingness and ability to complete HIPAA training, sign NDAs, and sign IP assignments.",{"type":111,"tag":112,"props":226,"children":228},{"id":227},"nice-to-haves",[229],{"type":117,"value":230},"Nice to haves",{"type":111,"tag":137,"props":232,"children":233},{},[234,239],{"type":111,"tag":141,"props":235,"children":236},{},[237],{"type":117,"value":238},"1+ years Direct experience working in Healthcare or handling regulated data/PHI.",{"type":111,"tag":141,"props":240,"children":241},{},[242],{"type":117,"value":243},"1+ years Cloud infrastructure experience with Google Cloud Platform (GCP).",{"type":111,"tag":112,"props":245,"children":247},{"id":246},"frequently-asked-questions",[248],{"type":117,"value":249},"Frequently Asked Questions",{"type":111,"tag":251,"props":252,"children":253},"blockquote",{},[254],{"type":111,"tag":120,"props":255,"children":256},{},[257],{"type":111,"tag":258,"props":259,"children":260},"em",{},[261],{"type":117,"value":262},"What are your typical clients?",{"type":111,"tag":120,"props":264,"children":265},{},[266],{"type":117,"value":267},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":111,"tag":251,"props":269,"children":270},{},[271],{"type":111,"tag":120,"props":272,"children":273},{},[274],{"type":111,"tag":258,"props":275,"children":276},{},[277],{"type":117,"value":278},"What is the length of your engagements?",{"type":111,"tag":120,"props":280,"children":281},{},[282],{"type":117,"value":283},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":111,"tag":251,"props":285,"children":286},{},[287],{"type":111,"tag":120,"props":288,"children":289},{},[290],{"type":111,"tag":258,"props":291,"children":292},{},[293],{"type":117,"value":294},"What’s your company size?",{"type":111,"tag":120,"props":296,"children":297},{},[298],{"type":117,"value":299},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 50+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":111,"tag":251,"props":301,"children":302},{},[303],{"type":111,"tag":120,"props":304,"children":305},{},[306],{"type":111,"tag":258,"props":307,"children":308},{},[309],{"type":117,"value":310},"What happens if the engagement is completed?",{"type":111,"tag":120,"props":312,"children":313},{},[314],{"type":117,"value":315},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":111,"tag":251,"props":317,"children":318},{},[319],{"type":111,"tag":120,"props":320,"children":321},{},[322],{"type":111,"tag":258,"props":323,"children":324},{},[325],{"type":117,"value":326},"What are your core values?",{"type":111,"tag":120,"props":328,"children":329},{},[330],{"type":117,"value":331},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":111,"tag":120,"props":333,"children":334},{},[335],{"type":117,"value":336},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":111,"tag":120,"props":338,"children":339},{},[340],{"type":117,"value":341},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":8,"searchDepth":19,"depth":19,"links":343},[344,345,346,347,348,349],{"id":114,"depth":19,"text":118},{"id":127,"depth":19,"text":130},{"id":168,"depth":19,"text":171},{"id":198,"depth":19,"text":201},{"id":227,"depth":19,"text":230},{"id":246,"depth":19,"text":249},"content:opportunities:ai-engineer-476.md","opportunities/ai-engineer-476.md",{"_path":353,"_dir":95,"_draft":7,"_partial":7,"_locale":8,"title":354,"description":8,"draft":7,"tags":355,"related_content":356,"short_title":354,"header_one":357,"header_two":358,"header_three":8,"cta_header":102,"cta_button":103,"cta_href":104,"icon":8,"icons":359,"image_url":8,"hero_image":8,"body":362,"_type":21,"_id":587,"_source":23,"_file":588,"_extension":25},"/opportunities/it-security-engineer-475","IT & Security Engineer",[98],[],"IT & Security","Engineer",[360,361],"monitor-account","lock-check",{"type":16,"children":363,"toc":579},[364,368,373,377,382,387,392,400,404,423,427,464,468,496,500,510,514,524,528,538,543,553,557,567,571,575],{"type":111,"tag":112,"props":365,"children":366},{"id":114},[367],{"type":117,"value":118},{"type":111,"tag":120,"props":369,"children":370},{},[371],{"type":117,"value":372},"Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":111,"tag":112,"props":374,"children":375},{"id":127},[376],{"type":117,"value":130},{"type":111,"tag":120,"props":378,"children":379},{},[380],{"type":117,"value":381},"Right Balance is taking its cybersecurity program to the next level to further protect its workforce, company information, and access to client environments.",{"type":111,"tag":120,"props":383,"children":384},{},[385],{"type":117,"value":386},"You will work directly with Right Balance’s Fractional CISO to improve and operate the company’s IT and security controls across a distributed workforce. This is a hands-on technical role focused on turning new security requirements and policies into practical, working solutions.\nYou will help deploy, configure, and administer endpoint security, device management, identity and access controls, patch management, security awareness tools, and supporting IT/security processes. The environment includes a mix of Windows, macOS, and Linux endpoints.",{"type":111,"tag":120,"props":388,"children":389},{},[390],{"type":117,"value":391},"The initial engagement will focus on implementing the next version of Right Balance’s Security Program over approximately six months, with the potential for continued ongoing IT and security support following implementation.",{"type":111,"tag":137,"props":393,"children":394},{},[395],{"type":111,"tag":141,"props":396,"children":397},{},[398],{"type":117,"value":399},"Availability: Part-time, approximately 10 hours per week, with flexibility based on project needs.",{"type":111,"tag":112,"props":401,"children":402},{"id":168},[403],{"type":117,"value":171},{"type":111,"tag":173,"props":405,"children":406},{},[407,411,415,419],{"type":111,"tag":141,"props":408,"children":409},{},[410],{"type":117,"value":180},{"type":111,"tag":141,"props":412,"children":413},{},[414],{"type":117,"value":185},{"type":111,"tag":141,"props":416,"children":417},{},[418],{"type":117,"value":190},{"type":111,"tag":141,"props":420,"children":421},{},[422],{"type":117,"value":195},{"type":111,"tag":112,"props":424,"children":425},{"id":198},[426],{"type":117,"value":201},{"type":111,"tag":137,"props":428,"children":429},{},[430,434,439,444,449,454,459],{"type":111,"tag":141,"props":431,"children":432},{},[433],{"type":117,"value":209},{"type":111,"tag":141,"props":435,"children":436},{},[437],{"type":117,"value":438},"5+ years of hands-on IT systems administration, endpoint management, or cybersecurity experience.",{"type":111,"tag":141,"props":440,"children":441},{},[442],{"type":117,"value":443},"Hands-on experience managing Windows and macOS endpoints, including endpoint security/EDR, patching, device management, and troubleshooting.",{"type":111,"tag":141,"props":445,"children":446},{},[447],{"type":117,"value":448},"Experience with identity and access management (IAM), including MFA, user provisioning/deprovisioning, and access controls.",{"type":111,"tag":141,"props":450,"children":451},{},[452],{"type":117,"value":453},"Experience administering Google Workspace and supporting users in a cloud-based, remote environment.",{"type":111,"tag":141,"props":455,"children":456},{},[457],{"type":117,"value":458},"Working knowledge of endpoint security, vulnerability remediation, malware protection, and security best practices.",{"type":111,"tag":141,"props":460,"children":461},{},[462],{"type":117,"value":463},"Strong troubleshooting, documentation, and communication skills with the ability to work independently and own technical tasks through completion.",{"type":111,"tag":112,"props":465,"children":466},{"id":227},[467],{"type":117,"value":230},{"type":111,"tag":137,"props":469,"children":470},{},[471,476,481,486,491],{"type":111,"tag":141,"props":472,"children":473},{},[474],{"type":117,"value":475},"Experience with JumpCloud or similar identity, device, and patch management platforms.",{"type":111,"tag":141,"props":477,"children":478},{},[479],{"type":117,"value":480},"Experience supporting BYOD and Linux/Ubuntu endpoints.",{"type":111,"tag":141,"props":482,"children":483},{},[484],{"type":117,"value":485},"Familiarity with security awareness/phishing platforms, vulnerability management, and security compliance or audit evidence collection.",{"type":111,"tag":141,"props":487,"children":488},{},[489],{"type":117,"value":490},"Familiarity with NIST, CIS Controls, or CIS Benchmarks.",{"type":111,"tag":141,"props":492,"children":493},{},[494],{"type":117,"value":495},"Relevant IT/security certifications and/or a Bachelor’s degree in Computer Science or equivalent demonstrated ability.",{"type":111,"tag":112,"props":497,"children":498},{"id":246},[499],{"type":117,"value":249},{"type":111,"tag":251,"props":501,"children":502},{},[503],{"type":111,"tag":120,"props":504,"children":505},{},[506],{"type":111,"tag":258,"props":507,"children":508},{},[509],{"type":117,"value":262},{"type":111,"tag":120,"props":511,"children":512},{},[513],{"type":117,"value":267},{"type":111,"tag":251,"props":515,"children":516},{},[517],{"type":111,"tag":120,"props":518,"children":519},{},[520],{"type":111,"tag":258,"props":521,"children":522},{},[523],{"type":117,"value":278},{"type":111,"tag":120,"props":525,"children":526},{},[527],{"type":117,"value":283},{"type":111,"tag":251,"props":529,"children":530},{},[531],{"type":111,"tag":120,"props":532,"children":533},{},[534],{"type":111,"tag":258,"props":535,"children":536},{},[537],{"type":117,"value":294},{"type":111,"tag":120,"props":539,"children":540},{},[541],{"type":117,"value":542},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":111,"tag":251,"props":544,"children":545},{},[546],{"type":111,"tag":120,"props":547,"children":548},{},[549],{"type":111,"tag":258,"props":550,"children":551},{},[552],{"type":117,"value":310},{"type":111,"tag":120,"props":554,"children":555},{},[556],{"type":117,"value":315},{"type":111,"tag":251,"props":558,"children":559},{},[560],{"type":111,"tag":120,"props":561,"children":562},{},[563],{"type":111,"tag":258,"props":564,"children":565},{},[566],{"type":117,"value":326},{"type":111,"tag":120,"props":568,"children":569},{},[570],{"type":117,"value":331},{"type":111,"tag":120,"props":572,"children":573},{},[574],{"type":117,"value":336},{"type":111,"tag":120,"props":576,"children":577},{},[578],{"type":117,"value":341},{"title":8,"searchDepth":19,"depth":19,"links":580},[581,582,583,584,585,586],{"id":114,"depth":19,"text":118},{"id":127,"depth":19,"text":130},{"id":168,"depth":19,"text":171},{"id":198,"depth":19,"text":201},{"id":227,"depth":19,"text":230},{"id":246,"depth":19,"text":249},"content:opportunities:it-security-engineer-475.md","opportunities/it-security-engineer-475.md",{"_path":590,"_dir":95,"_draft":7,"_partial":7,"_locale":8,"title":591,"description":8,"draft":7,"tags":592,"related_content":593,"short_title":591,"header_one":594,"header_two":595,"header_three":8,"cta_header":102,"cta_button":103,"cta_href":104,"icon":8,"icons":596,"image_url":8,"hero_image":8,"body":599,"_type":21,"_id":880,"_source":23,"_file":881,"_extension":25},"/opportunities/shopify-ecommerce-coordinator-460","Shopify Ecommerce Experience Coordinator",[98],[],"Shopify Ecommerce","Experience Coordinator",[597,598],"account-group","shopping-outline",{"type":16,"children":600,"toc":872},[601,605,610,614,619,624,629,677,682,686,705,709,757,761,789,793,803,807,817,821,831,836,846,850,860,864,868],{"type":111,"tag":112,"props":602,"children":603},{"id":114},[604],{"type":117,"value":118},{"type":111,"tag":120,"props":606,"children":607},{},[608],{"type":117,"value":609},"We're looking for a Shopify Ecommerce Experience Coordinator. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":111,"tag":112,"props":611,"children":612},{"id":127},[613],{"type":117,"value":130},{"type":111,"tag":120,"props":615,"children":616},{},[617],{"type":117,"value":618},"Our client is a fast-growing, natural personal-care brand with a high-traffic Shopify storefront and a rapidly expanding retail presence. You'll own and optimize the day-to-day ecommerce experience across their storefront. This role goes beyond content management: it combines merchandising, ecommerce operations, experimentation, and analytics to continuously improve the customer journey and drive conversion.",{"type":111,"tag":120,"props":620,"children":621},{},[622],{"type":117,"value":623},"The ideal candidate is analytical, detail-oriented, and comfortable making data-driven decisions based on user behavior, A/B testing, and ecommerce performance insights.",{"type":111,"tag":120,"props":625,"children":626},{},[627],{"type":117,"value":628},"What You’ll Do:",{"type":111,"tag":137,"props":630,"children":631},{},[632,637,642,647,652,657,662,667,672],{"type":111,"tag":141,"props":633,"children":634},{},[635],{"type":117,"value":636},"Own and manage all content launches across the Shopify storefront.",{"type":111,"tag":141,"props":638,"children":639},{},[640],{"type":117,"value":641},"Manage and maintain Shopify Admin, including products, collections, tags, and inventory.",{"type":111,"tag":141,"props":643,"children":644},{},[645],{"type":117,"value":646},"Coordinate product launches and merchandising initiatives.",{"type":111,"tag":141,"props":648,"children":649},{},[650],{"type":117,"value":651},"Create and update landing pages.",{"type":111,"tag":141,"props":653,"children":654},{},[655],{"type":117,"value":656},"Support SEO optimization efforts.",{"type":111,"tag":141,"props":658,"children":659},{},[660],{"type":117,"value":661},"Plan, execute, and monitor A/B testing initiatives.",{"type":111,"tag":141,"props":663,"children":664},{},[665],{"type":117,"value":666},"Analyze customer behavior and ecommerce funnel performance to identify optimization opportunities.",{"type":111,"tag":141,"props":668,"children":669},{},[670],{"type":117,"value":671},"Make strategic recommendations based on data and user insights.",{"type":111,"tag":141,"props":673,"children":674},{},[675],{"type":117,"value":676},"Collaborate with cross-functional teams to continuously improve the online shopping experience.",{"type":111,"tag":120,"props":678,"children":679},{},[680],{"type":117,"value":681},"Availability: Part-time hours. Long-term engagement with the potential to scale to full-time",{"type":111,"tag":112,"props":683,"children":684},{"id":168},[685],{"type":117,"value":171},{"type":111,"tag":173,"props":687,"children":688},{},[689,693,697,701],{"type":111,"tag":141,"props":690,"children":691},{},[692],{"type":117,"value":180},{"type":111,"tag":141,"props":694,"children":695},{},[696],{"type":117,"value":185},{"type":111,"tag":141,"props":698,"children":699},{},[700],{"type":117,"value":190},{"type":111,"tag":141,"props":702,"children":703},{},[704],{"type":117,"value":195},{"type":111,"tag":112,"props":706,"children":707},{"id":198},[708],{"type":117,"value":201},{"type":111,"tag":137,"props":710,"children":711},{},[712,717,722,727,732,737,742,747,752],{"type":111,"tag":141,"props":713,"children":714},{},[715],{"type":117,"value":716},"Advanced to fluent speaking and writing English. Able to have a real-time conversation.",{"type":111,"tag":141,"props":718,"children":719},{},[720],{"type":117,"value":721},"3+ years managing Shopify storefronts.",{"type":111,"tag":141,"props":723,"children":724},{},[725],{"type":117,"value":726},"3+ years in ecommerce operations and merchandising.",{"type":111,"tag":141,"props":728,"children":729},{},[730],{"type":117,"value":731},"2+ years coordinating content and product launches.",{"type":111,"tag":141,"props":733,"children":734},{},[735],{"type":117,"value":736},"2+ years with A/B testing and conversion optimization.",{"type":111,"tag":141,"props":738,"children":739},{},[740],{"type":117,"value":741},"Analytical mindset with the ability to interpret customer behavior and ecommerce metrics.",{"type":111,"tag":141,"props":743,"children":744},{},[745],{"type":117,"value":746},"Strong organizational skills and attention to detail.",{"type":111,"tag":141,"props":748,"children":749},{},[750],{"type":117,"value":751},"Customer-centric approach to decision-making.",{"type":111,"tag":141,"props":753,"children":754},{},[755],{"type":117,"value":756},"Ability to prioritize multiple initiatives in a fast-paced environment.",{"type":111,"tag":112,"props":758,"children":759},{"id":227},[760],{"type":117,"value":230},{"type":111,"tag":137,"props":762,"children":763},{},[764,769,774,779,784],{"type":111,"tag":141,"props":765,"children":766},{},[767],{"type":117,"value":768},"Experience with SEO best practices.",{"type":111,"tag":141,"props":770,"children":771},{},[772],{"type":117,"value":773},"Experience optimizing ecommerce funnels and customer journeys.",{"type":111,"tag":141,"props":775,"children":776},{},[777],{"type":117,"value":778},"Familiarity with product merchandising strategies.",{"type":111,"tag":141,"props":780,"children":781},{},[782],{"type":117,"value":783},"Experience working with Shopify apps and ecommerce optimization tools.",{"type":111,"tag":141,"props":785,"children":786},{},[787],{"type":117,"value":788},"Experience supporting high-growth ecommerce brands.",{"type":111,"tag":112,"props":790,"children":791},{"id":246},[792],{"type":117,"value":249},{"type":111,"tag":251,"props":794,"children":795},{},[796],{"type":111,"tag":120,"props":797,"children":798},{},[799],{"type":111,"tag":258,"props":800,"children":801},{},[802],{"type":117,"value":262},{"type":111,"tag":120,"props":804,"children":805},{},[806],{"type":117,"value":267},{"type":111,"tag":251,"props":808,"children":809},{},[810],{"type":111,"tag":120,"props":811,"children":812},{},[813],{"type":111,"tag":258,"props":814,"children":815},{},[816],{"type":117,"value":278},{"type":111,"tag":120,"props":818,"children":819},{},[820],{"type":117,"value":283},{"type":111,"tag":251,"props":822,"children":823},{},[824],{"type":111,"tag":120,"props":825,"children":826},{},[827],{"type":111,"tag":258,"props":828,"children":829},{},[830],{"type":117,"value":294},{"type":111,"tag":120,"props":832,"children":833},{},[834],{"type":117,"value":835},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 200+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":111,"tag":251,"props":837,"children":838},{},[839],{"type":111,"tag":120,"props":840,"children":841},{},[842],{"type":111,"tag":258,"props":843,"children":844},{},[845],{"type":117,"value":310},{"type":111,"tag":120,"props":847,"children":848},{},[849],{"type":117,"value":315