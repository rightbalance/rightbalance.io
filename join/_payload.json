partial":7,"_locale":8,"title":1138,"description":8,"draft":7,"tags":1139,"related_content":1140,"short_title":1138,"header_one":1141,"header_two":1142,"header_three":8,"cta_header":102,"cta_button":103,"cta_href":104,"icon":8,"icons":1143,"image_url":8,"hero_image":8,"body":1146,"_type":21,"_id":1381,"_source":23,"_file":1382,"_extension":25},"/opportunities/ta-coordinator-446","Talent Acquisition Coordinator",[98],[],"Talent Acquisition","Coordinator",[1144,1145],"account-group","archive",{"type":16,"children":1147,"toc":1373},[1148,1152,1157,1161,1166,1171,1204,1209,1213,1232,1236,1268,1272,1290,1294,1304,1308,1318,1322,1332,1337,1347,1351,1361,1365,1369],{"type":111,"tag":112,"props":1149,"children":1150},{"id":114},[1151],{"type":117,"value":118},{"type":111,"tag":120,"props":1153,"children":1154},{},[1155],{"type":117,"value":1156},"We're looking for a Talent Acquisition Coordinator. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":111,"tag":112,"props":1158,"children":1159},{"id":127},[1160],{"type":117,"value":130},{"type":111,"tag":120,"props":1162,"children":1163},{},[1164],{"type":117,"value":1165},"Our client is a globally recognized leader in interactive entertainment, operating some of the most played games in the world with hundreds of millions of players across multiple titles. Their Recruiting team plays a critical role in attracting and engaging top talent to help build the future of their games and experiences. As part of this team, you'll collaborate with recruiters, hiring managers, and candidates to support the end-to-end recruitment process, drive operational excellence, and contribute to projects that enhance their recruiting efforts. The Coordinator's primary goal is to guide candidates through the pipeline efficiently, with candidate experience at the heart of the mission, from scheduling screens and onsites to hosting candidates and facilitating logistics.",{"type":111,"tag":120,"props":1167,"children":1168},{},[1169],{"type":117,"value":1170},"What You’ll Do:",{"type":111,"tag":142,"props":1172,"children":1173},{},[1174,1179,1184,1189,1194,1199],{"type":111,"tag":146,"props":1175,"children":1176},{},[1177],{"type":117,"value":1178},"Work closely with recruiters, hiring managers, and HRBPs to schedule interviews and meetings in an efficient and timely manner.",{"type":111,"tag":146,"props":1180,"children":1181},{},[1182],{"type":117,"value":1183},"Handle candidate travel arrangements when needed, including hotel and airline booking options.",{"type":111,"tag":146,"props":1185,"children":1186},{},[1187],{"type":117,"value":1188},"Maintain recruiting system data integrity, including open roles and candidate information and communication.",{"type":111,"tag":146,"props":1190,"children":1191},{},[1192],{"type":117,"value":1193},"Conduct hiring efficiency analysis for the team and provide insights.",{"type":111,"tag":146,"props":1195,"children":1196},{},[1197],{"type":117,"value":1198},"Handle and prioritize a wide range of advanced administrative duties, using discretion and independent judgment to determine interview dates, logistics, and related outcomes.",{"type":111,"tag":146,"props":1200,"children":1201},{},[1202],{"type":117,"value":1203},"Influence the adoption of best practices, tools, and processes related to recruiting coordination.",{"type":111,"tag":120,"props":1205,"children":1206},{},[1207],{"type":117,"value":1208},"Availability: Full-time, based in Sydney under a hybrid work model with regular in-office attendance.",{"type":111,"tag":112,"props":1210,"children":1211},{"id":153},[1212],{"type":117,"value":156},{"type":111,"tag":158,"props":1214,"children":1215},{},[1216,1220,1224,1228],{"type":111,"tag":146,"props":1217,"children":1218},{},[1219],{"type":117,"value":165},{"type":111,"tag":146,"props":1221,"children":1222},{},[1223],{"type":117,"value":170},{"type":111,"tag":146,"props":1225,"children":1226},{},[1227],{"type":117,"value":175},{"type":111,"tag":146,"props":1229,"children":1230},{},[1231],{"type":117,"value":180},{"type":111,"tag":112,"props":1233,"children":1234},{"id":183},[1235],{"type":117,"value":186},{"type":111,"tag":142,"props":1237,"children":1238},{},[1239,1243,1248,1253,1258,1263],{"type":111,"tag":146,"props":1240,"children":1241},{},[1242],{"type":117,"value":194},{"type":111,"tag":146,"props":1244,"children":1245},{},[1246],{"type":117,"value":1247},"3+ years of experience in a Recruiting Coordinator, Talent Acquisition Coordinator, HR Coordinator, or similar role.",{"type":111,"tag":146,"props":1249,"children":1250},{},[1251],{"type":117,"value":1252},"Excellent interpersonal and stakeholder management skills.",{"type":111,"tag":146,"props":1254,"children":1255},{},[1256],{"type":117,"value":1257},"Prior experience using HR systems, resources, and tools.",{"type":111,"tag":146,"props":1259,"children":1260},{},[1261],{"type":117,"value":1262},"Proficiency with Google Workspace (Gmail, Calendar, Docs, Sheets, and Slides).",{"type":111,"tag":146,"props":1264,"children":1265},{},[1266],{"type":117,"value":1267},"Strong organizational skills with the ability to manage multiple priorities in a fast-paced environment.",{"type":111,"tag":112,"props":1269,"children":1270},{"id":227},[1271],{"type":117,"value":230},{"type":111,"tag":142,"props":1273,"children":1274},{},[1275,1280,1285],{"type":111,"tag":146,"props":1276,"children":1277},{},[1278],{"type":117,"value":1279},"Experience with ATS and CRM platforms.",{"type":111,"tag":146,"props":1281,"children":1282},{},[1283],{"type":117,"value":1284},"Experience coordinating interviews across multiple time zones and stakeholder groups.",{"type":111,"tag":146,"props":1286,"children":1287},{},[1288],{"type":117,"value":1289},"Passion for games and the gaming industry.",{"type":111,"tag":112,"props":1291,"children":1292},{"id":241},[1293],{"type":117,"valu