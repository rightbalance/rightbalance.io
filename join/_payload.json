e Impact",[6],[],"No bureaucracy, deliver meaningful changes","speedometer",{"type":16,"children":61,"toc":62},[],{"title":8,"searchDepth":19,"depth":19,"links":63},[],"content:join:4_make-impact.md","join/4_make-impact.md",{"_path":67,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":68,"description":8,"tags":69,"related_content":70,"short_title":68,"header_one":68,"header_two":71,"icon":72,"body":73,"_type":21,"_id":77,"_source":23,"_file":78,"_extension":25},"/join/5_challenge","Challenge",[6],[],"the old beliefs with new technology","vector-intersection",{"type":16,"children":74,"toc":75},[],{"title":8,"searchDepth":19,"depth":19,"links":76},[],"content:join:5_challenge.md","join/5_challenge.md",{"_path":80,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":81,"description":8,"tags":82,"related_content":83,"short_title":81,"header_one":81,"header_two":84,"icon":85,"body":86,"_type":21,"_id":90,"_source":23,"_file":91,"_extension":25},"/join/6_recharge","Recharge",[6],[],"We pay vacations and local holidays","bag-carry-on",{"type":16,"children":87,"toc":88},[],{"title":8,"searchDepth":19,"depth":19,"links":89},[],"content:join:6_recharge.md","join/6_recharge.md",[93,428,720,967,1263],{"_path":94,"_dir":95,"_draft":7,"_partial":7,"_locale":8,"title":96,"description":8,"draft":7,"tags":97,"related_content":99,"short_title":96,"header_one":100,"header_two":101,"header_three":8,"cta_header":102,"cta_button":103,"cta_href":104,"icon":8,"icons":105,"image_url":8,"hero_image":8,"body":109,"_type":21,"_id":426,"_source":23,"_file":427,"_extension":25},"/opportunities/fullstack-shopify-458","opportunities","Full Stack Developer - Shopify",[98],"oportunity",[],"Full Stack Developer","Shopify","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrn4RALUBunWkfJd",[106,107,108],"account-wrench","language-javascript","cart",{"type":16,"children":110,"toc":418},[111,120,126,132,137,142,147,187,192,198,222,228,296,302,320,326,339,344,355,360,371,376,387,392,403,408,413],{"type":112,"tag":113,"props":114,"children":116},"element","h2",{"id":115},"overview",[117],{"type":118,"value":119},"text","Overview",{"type":112,"tag":121,"props":122,"children":123},"p",{},[124],{"type":118,"value":125},"We're looking for a Full Stack Developer - Shopify. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":112,"tag":113,"props":127,"children":129},{"id":128},"client-engagement-details",[130],{"type":118,"value":131},"Client Engagement Details",{"type":112,"tag":121,"props":133,"children":134},{},[135],{"type":118,"value":136},"Our client offers and manufactures grooming products of soap, deodorant, shampoo, and toothpaste with natural ingredients for men.",{"type":112,"tag":121,"props":138,"children":139},{},[140],{"type":118,"value":141},"Overview\nWe're looking for a Senior Full Stack Shopify Developer to help scale and optimize a Shopify storefront built on a custom Shopify Liquid theme. This will be the most senior technical resource on the team, responsible for improving existing functionality, building new features, and supporting the continued evolution of the ecommerce platform.",{"type":112,"tag":121,"props":143,"children":144},{},[145],{"type":118,"value":146},"Key Responsibilities",{"type":112,"tag":148,"props":149,"children":150},"ul",{},[151,157,162,167,172,177,182],{"type":112,"tag":152,"props":153,"children":154},"li",{},[155],{"type":118,"value":156},"Optimize and enhance the existing Shopify storefront.",{"type":112,"tag":152,"props":158,"children":159},{},[160],{"type":118,"value":161},"Improve and maintain the custom bundle builder.",{"type":112,"tag":152,"props":163,"children":164},{},[165],{"type":118,"value":166},"Build and maintain Shopify Functions.",{"type":112,"tag":152,"props":168,"children":169},{},[170],{"type":118,"value":171},"Develop and maintain API integrations.",{"type":112,"tag":152,"props":173,"children":174},{},[175],{"type":118,"value":176},"Support A/B testing implementation and experimentation.",{"type":112,"tag":152,"props":178,"children":179},{},[180],{"type":118,"value":181},"Improve storefront performance and overall user experience.",{"type":112,"tag":152,"props":183,"children":184},{},[185],{"type":118,"value":186},"Collaborate with cross-functional stakeholders to deliver scalable ecommerce solutions.",{"type":112,"tag":121,"props":188,"children":189},{},[190],{"type":118,"value":191},"Availability: Part-Time - long term project with chances to scale to full time.",{"type":112,"tag":113,"props":193,"children":195},{"id":194},"whats-in-it-for-you",[196],{"type":118,"value":197},"What’s in it for you",{"type":112,"tag":199,"props":200,"children":201},"ol",{},[202,207,212,217],{"type":112,"tag":152,"props":203,"children":204},{},[205],{"type":118,"value":206},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":112,"tag":152,"props":208,"children":209},{},[210],{"type":118,"value":211},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":112,"tag":152,"props":213,"children":214},{},[215],{"type":118,"value":216},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":112,"tag":152,"props":218,"children":219},{},[220],{"type":118,"value":221},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":112,"tag":113,"props":223,"children":225},{"id":224},"required-qualifications",[226],{"type":118,"value":227},"Required Qualifications",{"type":112,"tag":148,"props":229,"children":230},{},[231,236,241,246,251,256,261,266,271,276,281,286,291],{"type":112,"tag":152,"props":232,"children":233},{},[234],{"type":118,"value":235},"Upper-intermediate to fluent speaking and writing English. Able to have a real-time conversation.",{"type":112,"tag":152,"props":237,"children":238},{},[239],{"type":118,"value":240},"5+ years of full-time hands-on Shopify Plus experience.",{"type":112,"tag":152,"props":242,"children":243},{},[244],{"type":118,"value":245},"4+ years of full-time hands-on Liquid experience.",{"type":112,"tag":152,"props":247,"children":248},{},[249],{"type":118,"value":250},"4+ years of full-time hands-on React experience.",{"type":112,"tag":152,"props":252,"children":253},{},[254],{"type":118,"value":255},"3+ years of full-time hands-on Javascript experience.",{"type":112,"tag":152,"props":257,"children":258},{},[259],{"type":118,"value":260},"Strong experience with Shopify Plus and custom Shopify development.",{"type":112,"tag":152,"props":262,"children":263},{},[264],{"type":118,"value":265},"Advanced knowledge of Liquid.",{"type":112,"tag":152,"props":267,"children":268},{},[269],{"type":118,"value":270},"Strong experience with React.",{"type":112,"tag":152,"props":272,"children":273},{},[274],{"type":118,"value":275},"Proficiency in JavaScript.",{"type":112,"tag":152,"props":277,"children":278},{},[279],{"type":118,"value":280},"Experience building Shopify Functions.",{"type":112,"tag":152,"props":282,"children":283},{},[284],{"type":118,"value":285},"Experience developing and maintaining API integrations.",{"type":112,"tag":152,"props":287,"children":288},{},[289],{"type":118,"value":290},"Experience implementing and supporting A/B testing initiatives.",{"type":112,"tag":152,"props":292,"children":293},{},[294],{"type":118,"value":295},"Ability to work independently and provide technical leadership.",{"type":112,"tag":113,"props":297,"children":299},{"id":298},"nice-to-haves",[300],{"type":118,"value":301},"Nice to haves",{"type":112,"tag":148,"props":303,"children":304},{},[305,310,315],{"type":112,"tag":152,"props":306,"children":307},{},[308],{"type":118,"value":309},"Basic familiarity with Python.",{"type":112,"tag":152,"props":311,"children":312},{},[313],{"type":118,"value":314},"Experience optimizing custom ecommerce experiences and Shopify storefront performance.",{"type":112,"tag":152,"props":316,"children":317},{},[318],{"type":118,"value":319},"Bachelor’s degree in Computer Science or equivalent demonstrated ability.",{"type":112,"tag":113,"props":321,"children":323},{"id":322},"frequently-asked-questions",[324],{"type":118,"value":325},"Frequently Asked Questions",{"type":112,"tag":327,"props":328,"children":329},"blockquote",{},[330],{"type":112,"tag":121,"props":331,"children":332},{},[333],{"type":112,"tag":334,"props":335,"children":336},"em",{},[337],{"type":118,"value":338},"What are your typical clients?",{"type":112,"tag":121,"props":340,"children":341},{},[342],{"type":118,"value":343},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":112,"tag":327,"props":345,"children":346},{},[347],{"type":112,"tag":121,"props":348,"children":349},{},[350],{"type":112,"tag":334,"props":351,"children":352},{},[353],{"type":118,"value":354},"What is the length of your engagements?",{"type":112,"tag":121,"props":356,"children":357},{},[358],{"type":118,"value":359},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":112,"tag":327,"props":361,"children":362},{},[363],{"type":112,"tag":121,"props":364,"children":365},{},[366],{"type":112,"tag":334,"props":367,"children":368},{},[369],{"type":118,"value":370},"What’s your company size?",{"type":112,"tag":121,"props":372,"children":373},{},[374],{"type":118,"value":375},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 200+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":112,"tag":327,"props":377,"children":378},{},[379],{"type":112,"tag":121,"props":380,"children":381},{},[382],{"type":112,"tag":334,"props":383,"children":384},{},[385],{"type":118,"value":386},"What happens if the engagement is completed?",{"type":112,"tag":121,"props":388,"children":389},{},[390],{"type":118,"value":391},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":112,"tag":327,"props":393,"children":394},{},[395],{"type":112,"tag":121,"props":396,"children":397},{},[398],{"type":112,"tag":334,"props":399,"children":400},{},[401],{"type":118,"value":402},"What are your core values?",{"type":112,"tag":121,"props":404,"children":405},{},[406],{"type":118,"value":407},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":112,"tag":121,"props":409,"children":410},{},[411],{"type":118,"value":412},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":112,"tag":121,"props":414,"children":415},{},[416],{"type":118,"value":417},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":8,"searchDepth":19,"depth":19,"links":419},[420,421,422,423,424,425],{"id":115,"depth":19,"text":119},{"id":128,"depth":19,"text":131},{"id":194,"depth":19,"text":197},{"id":224,"depth":19,"text":227},{"id":298,"depth":19,"text":301},{"id":322,"depth":19,"text":325},"content:opportunities:fullstack-shopify-458.md","opportunities/fullstack-shopify-458.md",{"_path":429,"_dir":95,"_draft":7,"_partial":7,"_locale":8,"title":430,"description":8,"draft":7,"tags":431,"related_content":432,"short_title":430,"header_one":433,"header_two":434,"header_three":8,"cta_header":102,"cta_button":103,"cta_href":104,"icon":8,"icons":435,"image_url":8,"hero_image":8,"body":438,"_type":21,"_id":718,"_source":23,"_file":719,"_extension":25},"/opportunities/shopify-ecommerce-coordinator-460","Shopify Ecommerce Experience Coordinator",[98],[],"Shopify Ecommerce","Experience Coordinator",[436,437],"account-group","shopping-outline",{"type":16,"children":439,"toc":710},[440,444,449,453,458,463,468,516,521,525,544,548,596,600,628,632,642,646,656,660,670,674,684,688,698,702,706],{"type":112,"tag":113,"props":441,"children":442},{"id":115},[443],{"type":118,"value":119},{"type":112,"tag":121,"props":445,"children":446},{},[447],{"type":118,"value":448},"We're looking for a Shopify Ecommerce Experience Coordinator. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":112,"tag":113,"props":450,"children":451},{"id":128},[452],{"type":118,"value":131},{"type":112,"tag":121,"props":454,"children":455},{},[456],{"type":118,"value":457},"Our client is a fast-growing, natural personal-care brand with a high-traffic Shopify storefront and a rapidly expanding retail presence. You'll own and optimize the day-to-day ecommerce experience across their storefront. This role goes beyond content management: it combines merchandising, ecommerce operations, experimentation, and analytics to continuously improve the customer journey and drive conversion.",{"type":112,"tag":121,"props":459,"children":460},{},[461],{"type":118,"value":462},"The ideal candidate is analytical, detail-oriented, and comfortable making data-driven decisions based on user behavior, A/B testing, and ecommerce performance insights.",{"type":112,"tag":121,"props":464,"children":465},{},[466],{"type":118,"value":467},"What You’ll Do:",{"type":112,"tag":148,"props":469,"children":470},{},[471,476,481,486,491,496,501,506,511],{"type":112,"tag":152,"props":472,"children":473},{},[474],{"type":118,"value":475},"Own and manage all content launches across the Shopify storefront.",{"type":112,"tag":152,"props":477,"children":478},{},[479],{"type":118,"value":480},"Manage and maintain Shopify Admin, including products, collections, tags, and inventory.",{"type":112,"tag":152,"props":482,"children":483},{},[484],{"type":118,"value":485},"Coordinate product launches and merchandising initiatives.",{"type":112,"tag":152,"props":487,"children":488},{},[489],{"type":118,"value":490},"Create and update landing pages.",{"type":112,"tag":152,"props":492,"children":493},{},[494],{"type":118,"value":495},"Support SEO optimization efforts.",{"type":112,"tag":152,"props":497,"children":498},{},[499],{"type":118,"value":500},"Plan, execute, and monitor A/B testing initiatives.",{"type":112,"tag":152,"props":502,"children":503},{},[504],{"type":118,"value":505},"Analyze customer behavior and ecommerce funnel performance to identify optimization opportunities.",{"type":112,"tag":152,"props":507,"children":508},{},[509],{"type":118,"value":510},"Make strategic recommendations based on data and user insights.",{"type":112,"tag":152,"props":512,"children":513},{},[514],{"type":118,"value":515},"Collaborate with cross-functional teams to continuously improve the online shopping experience.",{"type":112,"tag":121,"props":517,"children":518},{},[519],{"type":118,"value":520},"Availability: Part-time hours. Long-term engagement with the potential to scale to full-time",{"type":112,"tag":113,"props":522,"children":523},{"id":194},[524],{"type":118,"value":197},{"type":112,"tag":199,"props":526,"children":527},{},[528,532,536,540],{"type":112,"tag":152,"props":529,"children":530},{},[531],{"type":118,"value":206},{"type":112,"tag":152,"props":533,"children":534},{},[535],{"type":118,"value":211},{"type":112,"tag":152,"props":537,"children":538},{},[539],{"type":118,"value":216},{"type":112,"tag":152,"props":541,"children":542},{},[543],{"type":118,"value":221},{"type":112,"tag":113,"props":545,"children":546},{"id":224},[547],{"type":118,"value":227},{"type":112,"tag":148,"props":549,"children":550},{},[551,556,561,566,571,576,581,586,591],{"type":112,"tag":152,"props":552,"children":553},{},[554],{"type":118,"value":555},"Advanced to fluent speaking and writing English. Able to have a real-time conversation.",{"type":112,"tag":152,"props":557,"children":558},{},[559],{"type":118,"value":560},"3+ years managing Shopify storefronts.",{"type":112,"tag":152,"props":562,"children":563},{},[564],{"type":118,"value":565},"3+ years in ecommerce operations and merchandising.",{"type":112,"tag":152,"props":567,"children":568},{},[569],{"type":118,"value":570},"2+ years coordinating content and product launches.",{"type":112,"tag":152,"props":572,"children":573},{},[574],{"type":118,"value":575},"2+ years with A/B testing and conversion optimization.",{"type":112,"tag":152,"props":577,"children":578},{},[579],{"type":118,"value":580},"Analytical mindset with the ability to interpret customer behavior and ecommerce metrics.",{"type":112,"tag":152,"props":582,"children":583},{},[584],{"type":118,"value":585},"Strong organizational skills and attention to detail.",{"type":112,"tag":152,"props":587,"children":588},{},[589],{"type":118,"value":590},"Customer-centric approach to decision-making.",{"type":112,"tag":152,"props":592,"children":593},{},[594],{"type":118,"value":595},"Ability to prioritize multiple initiatives in a fast-paced environment.",{"type":112,"tag":113,"props":597,"children":598},{"id":298},[599],{"type":118,"value":301},{"type":112,"tag":148,"props":601,"children":602},{},[603,608,613,618,623],{"type":112,"tag":152,"props":604,"children":605},{},[606],{"type":118,"value":607},"Experience with SEO best practices.",{"type":112,"tag":152,"props":609,"children":610},{},[611],{"type":118,"