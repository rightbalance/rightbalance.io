 Impact",[6],[],"No bureaucracy, deliver meaningful changes","speedometer",{"type":16,"children":61,"toc":62},[],{"title":8,"searchDepth":19,"depth":19,"links":63},[],"content:join:4_make-impact.md","join/4_make-impact.md",{"_path":67,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":68,"description":8,"tags":69,"related_content":70,"short_title":68,"header_one":68,"header_two":71,"icon":72,"body":73,"_type":21,"_id":77,"_source":23,"_file":78,"_extension":25},"/join/5_challenge","Challenge",[6],[],"the old beliefs with new technology","vector-intersection",{"type":16,"children":74,"toc":75},[],{"title":8,"searchDepth":19,"depth":19,"links":76},[],"content:join:5_challenge.md","join/5_challenge.md",{"_path":80,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":81,"description":8,"tags":82,"related_content":83,"short_title":81,"header_one":81,"header_two":84,"icon":85,"body":86,"_type":21,"_id":90,"_source":23,"_file":91,"_extension":25},"/join/6_recharge","Recharge",[6],[],"We pay vacations and local holidays","bag-carry-on",{"type":16,"children":87,"toc":88},[],{"title":8,"searchDepth":19,"depth":19,"links":89},[],"content:join:6_recharge.md","join/6_recharge.md",[93],{"_path":94,"_dir":95,"_draft":7,"_partial":7,"_locale":8,"title":96,"description":8,"draft":7,"tags":97,"related_content":99,"short_title":96,"header_one":100,"header_two":101,"header_three":8,"cta_header":102,"cta_button":103,"cta_href":104,"icon":8,"icons":105,"image_url":8,"hero_image":8,"body":108,"_type":21,"_id":425,"_source":23,"_file":426,"_extension":25},"/opportunities/shopify-ecommerce-coordinator-460","opportunities","Shopify Ecommerce Experience Coordinator",[98],"oportunity",[],"Shopify Ecommerce","Experience Coordinator","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrWu1M0aA9QTvTVF",[106,107],"account-group","shopping-outline",{"type":16,"children":109,"toc":417},[110,119,125,131,136,141,146,196,201,207,231,237,285,291,319,325,338,343,354,359,370,375,386,391,402,407,412],{"type":111,"tag":112,"props":113,"children":115},"element","h2",{"id":114},"overview",[116],{"type":117,"value":118},"text","Overview",{"type":111,"tag":120,"props":121,"children":122},"p",{},[123],{"type":117,"value":124},"We're looking for a Shopify Ecommerce Experience Coordinator. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":111,"tag":112,"props":126,"children":128},{"id":127},"client-engagement-details",[129],{"type":117,"value":130},"Client Engagement Details",{"type":111,"tag":120,"props":132,"children":133},{},[134],{"type":117,"value":135},"Our client is a fast-growing, natural personal-care brand with a high-traffic Shopify storefront and a rapidly expanding retail presence. You'll own and optimize the day-to-day ecommerce experience across their storefront. This role goes beyond content management: it combines merchandising, ecommerce operations, experimentation, and analytics to continuously improve the customer journey and drive conversion.",{"type":111,"tag":120,"props":137,"children":138},{},[139],{"type":117,"value":140},"The ideal candidate is analytical, detail-oriented, and comfortable making data-driven decisions based on user behavior, A/B testing, and ecommerce performance insights.",{"type":111,"tag":120,"props":142,"children":143},{},[144],{"type":117,"value":145},"What You’ll Do:",{"type":111,"tag":147,"props":148,"children":149},"ul",{},[150,156,161,166,171,176,181,186,191],{"type":111,"tag":151,"props":152,"children":153},"li",{},[154],{"type":117,"value":155},"Own and manage all content launches across the Shopify storefront.",{"type":111,"tag":151,"props":157,"children":158},{},[159],{"type":117,"value":160},"Manage and maintain Shopify Admin, including products, collections, tags, and inventory.",{"type":111,"tag":151,"props":162,"children":163},{},[164],{"type":117,"value":165},"Coordinate product launches and merchandising initiatives.",{"type":111,"tag":151,"props":167,"children":168},{},[169],{"type":117,"value":170},"Create and update landing pages.",{"type":111,"tag":151,"props":172,"children":173},{},[174],{"type":117,"value":175},"Support SEO optimization efforts.",{"type":111,"tag":151,"props":177,"children":178},{},[179],{"type":117,"value":180},"Plan, execute, and monitor A/B testing initiatives.",{"type":111,"tag":151,"props":182,"children":183},{},[184],{"type":117,"value":185},"Analyze customer behavior and ecommerce funnel performance to identify optimization opportunities.",{"type":111,"tag":151,"props":187,"children":188},{},[189],{"type":117,"value":190},"Make strategic recommendations based on data and user insights.",{"type":111,"tag":151,"props":192,"children":193},{},[194],{"type":117,"value":195},"Collaborate with cross-functional teams to continuously improve the online shopping experience.",{"type":111,"tag":120,"props":197,"children":198},{},[199],{"type":117,"value":200},"Availability: Part-time hours. Long-term engagement with the potential to scale to full-time",{"type":111,"tag":112,"props":202,"children":204},{"id":203},"whats-in-it-for-you",[205],{"type":117,"value":206},"What’s in it for you",{"type":111,"tag":208,"props":209,"children":210},"ol",{},[211,216,221,226],{"type":111,"tag":151,"props":212,"children":213},{},[214],{"type":117,"value":215},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":111,"tag":151,"props":217,"children":218},{},[219],{"type":117,"value":220},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":111,"tag":151,"props":222,"children":223},{},[224],{"type":117,"value":225},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":111,"tag":151,"props":227,"children":228},{},[229],{"type":117,"value":230},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":111,"tag":112,"props":232,"children":234},{"id":233},"required-qualifications",[235],{"type":117,"value":236},"Required Qualifications",{"type":111,"tag":147,"props":238,"children":239},{},[240,245,250,255,260,265,270,275,280],{"type":111,"tag":151,"props":241,"children":242},{},[243],{"type":117,"value":244},"Advanced to fluent speaking and writing English. Able to have a real-time conversation.",{"type":111,"tag":151,"props":246,"children":247},{},[248],{"type":117,"value":249},"3+ years managing Shopify storefronts.",{"type":111,"tag":151,"props":251,"children":252},{},[253],{"type":117,"value":254},"3+ years in ecommerce operations and merchandising.",{"type":111,"tag":151,"props":256,"children":257},{},[258],{"type":117,"value":259},"2+ years coordinating content and product launches.",{"type":111,"tag":151,"props":261,"children":262},{},[263],{"type":117,"value":264},"2+ years with A/B testing and conversion optimization.",{"type":111,"tag":151,"props":266,"children":267},{},[268],{"type":117,"value":269},"Analytical mindset with the ability to interpret customer behavior and ecommerce metrics.",{"type":111,"tag":151,"props":271,"children":272},{},[273],{"type":117,"value":274},"Strong organizational skills and attention to detail.",{"type":111,"tag":151,"props":276,"children":277},{},[278],{"type":117,"value":279},"Customer-centric approach to decision-making.",{"type":111,"tag":151,"props":281,"children":282},{},[283],{"type":117,"value":284},"Ability to prioritize multiple initiatives in a fast-paced environment.",{"type":111,"tag":112,"props":286,"children":288},{"id":287},"nice-to-haves",[289],{"type":117,"value":290},"Nice to haves",{"type":111,"tag":147,"props":292,"children":293},{},[294,299,304,309,314],{"type":111,"tag":151,"props":295,"children":296},{},[297],{"type":117,"value":298},"Experience with SEO best practices.",{"type":111,"tag":151,"props":300,"children":301},{},[302],{"type":117,"value":303},"Experience optimizing ecommerce funnels and customer journeys.",{"type":111,"tag":151,"props":305,"children":306},{},[307],{"type":117,"value":308},"Familiarity with product merchandising strategies.",{"type":111,"tag":151,"props":310,"children":311},{},[312],{"type":117,"value":313},"Experience working with Shopify apps and ecommerce optimization tools.",{"type":111,"tag":151,"props":315,"children":316},{},[317],{"type":117,"value":318},"Experience supporting high-growth ecommerce brands.",{"type":111,"tag":112,"props":320,"children":322},{"id":321},"frequently-asked-questions",[323],{"type":117,"value":324},"Frequently Asked Questions",{"type":111,"tag":326,"props":327,"children":328},"blockquote",{},[329],{"type":111,"tag":120,"props":330,"children":331},{},[332],{"type":111,"tag":333,"props":334,"children":335},"em",{},[336],{"type":117,"value":337},"What are your typical clients?",{"type":111,"tag":120,"props":339,"children":340},{},[341],{"type":117,"value":342},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":111,"tag":326,"props":344,"children":345},{},[346],{"type":111,"tag":120,"props":347,"children":348},{},[349],{"type":111,"tag":333,"props":350,"children":351},{},[352],{"type":117,"value":353},"What is the length of your engagements?",{"type":111,"tag":120,"props":355,"children":356},{},[357],{"type":117,"value":358},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":111,"tag":326,"props":360,"children":361},{},[362],{"type":111,"tag":120,"props":363,"children":364},{},[365],{"type":111,"tag":333,"props":366,"children":367},{},[368],{"type":117,"value":369},"What’s your company size?",{"type":111,"tag":120,"props":371,"children":372},{},[373],{"type":117,"value":374},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 200+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":111,"tag":326,"props":376,"children":377},{},[378],{"type":111,"tag":120,"props":379,"children":380},{},[381],{"type":111,"tag":333,"props":382,"children":383},{},[384],{"type":117,"value":385},"What happens if the engagement is completed?",{"type":111,"tag":120,"props":387,"children":388},{},[389],{"type":117,"value":390},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":111,"tag":326,"props":392,"children":393},{},[394],{"type":111,"tag":120,"props":395,"children":396},{},[397],{"type":111,"tag":333,"props":398,"children":399},{},[400],{"type":117,"value":401},"What are your core values?",{"type":111,"tag":120,"props":403,"children":404},{},[405],{"type":117,"value":406},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":111,"tag":120,"props":408,"children":409},{},[410],{"type":117,"value":411},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":111,"tag":120,"props":413,"children":414},{},[415],{"type":117,"value":416},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":8,"searchDepth":19,"depth":19,"links":418},[419,420,421,422,423,424],{"id":114,"depth":19,"text":118},{"id":127,"depth":19,"text":130},{"id":203,"depth":19,"text":206},{"id":233,"depth":19,"text":236},{"id":287,"depth":19,"text":290},{"id":321,"depth":19,"text":324},"content:opportunities:shopify-ecommerce-coordinator-460.md","opportunities/shopify-ecommerce-coordinator-460.md",1790226675113]