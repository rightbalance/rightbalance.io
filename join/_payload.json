e Impact",[6],[],"No bureaucracy, deliver meaningful changes","speedometer",{"type":16,"children":61,"toc":62},[],{"title":8,"searchDepth":19,"depth":19,"links":63},[],"content:join:4_make-impact.md","join/4_make-impact.md",{"_path":67,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":68,"description":8,"tags":69,"related_content":70,"short_title":68,"header_one":68,"header_two":71,"icon":72,"body":73,"_type":21,"_id":77,"_source":23,"_file":78,"_extension":25},"/join/5_challenge","Challenge",[6],[],"the old beliefs with new technology","vector-intersection",{"type":16,"children":74,"toc":75},[],{"title":8,"searchDepth":19,"depth":19,"links":76},[],"content:join:5_challenge.md","join/5_challenge.md",{"_path":80,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":81,"description":8,"tags":82,"related_content":83,"short_title":81,"header_one":81,"header_two":84,"icon":85,"body":86,"_type":21,"_id":90,"_source":23,"_file":91,"_extension":25},"/join/6_recharge","Recharge",[6],[],"We pay vacations and local holidays","bag-carry-on",{"type":16,"children":87,"toc":88},[],{"title":8,"searchDepth":19,"depth":19,"links":89},[],"content:join:6_recharge.md","join/6_recharge.md",[93,347,637,924,1136],{"_path":94,"_dir":95,"_draft":7,"_partial":7,"_locale":8,"title":96,"description":8,"draft":7,"tags":97,"related_content":99,"short_title":96,"header_one":100,"header_two":101,"header_three":8,"cta_header":102,"cta_button":103,"cta_href":104,"icon":8,"icons":105,"image_url":8,"hero_image":8,"body":108,"_type":21,"_id":345,"_source":23,"_file":346,"_extension":25},"/opportunities/backend-engineer-healthcare-441","opportunities","Backend Engineer (Healthcare)",[98],"oportunity",[],"Backend Engineer","Healthcare","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrn4RALUBunWkfJd",[106,107],"language-python","bottle-tonic-plus",{"type":16,"children":109,"toc":337},[110,119,125,131,136,141,151,157,181,187,225,231,239,245,258,263,274,279,290,295,306,311,322,327,332],{"type":111,"tag":112,"props":113,"children":115},"element","h2",{"id":114},"overview",[116],{"type":117,"value":118},"text","Overview",{"type":111,"tag":120,"props":121,"children":122},"p",{},[123],{"type":117,"value":124},"We're looking for a Backend Engineer (Healthcare). Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":111,"tag":112,"props":126,"children":128},{"id":127},"client-engagement-details",[129],{"type":117,"value":130},"Client Engagement Details",{"type":111,"tag":120,"props":132,"children":133},{},[134],{"type":117,"value":135},"Our client is disrupting the clinical trial enrollment process by transforming the way researchers identify eligible patients. Using artificial intelligence and natural language processing to mine structured and unstructured patient data, they find more, better-matching patients for trials in minutes, not months.\nThey work with some of the most prominent health systems, pharma companies, and CROs in the world, making the platform a crucial step in the clinical research workflow and greatly accelerating patients’ access to clinical trials.\nJoin the mission to bring life-saving treatments to patients faster with AI in clinical trials.",{"type":111,"tag":120,"props":137,"children":138},{},[139],{"type":117,"value":140},"Looking for a strong Backend Engineer with solid Python experience and healthcare domain knowledge. The engineer will support integrations with Electronic Medical Record (EMR) systems and work across a mix of in-house and third-party systems focused on lab order/result processing and clinical data pipelines.",{"type":111,"tag":142,"props":143,"children":144},"ul",{},[145],{"type":111,"tag":146,"props":147,"children":148},"li",{},[149],{"type":117,"value":150},"Availability: Full-time. Central Standard timezone. Monday-Friday software engineer on-duty rotation with on-call availability.",{"type":111,"tag":112,"props":152,"children":154},{"id":153},"whats-in-it-for-you",[155],{"type":117,"value":156},"What’s in it for you",{"type":111,"tag":158,"props":159,"children":160},"ol",{},[161,166,171,176],{"type":111,"tag":146,"props":162,"children":163},{},[164],{"type":117,"value":165},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":111,"tag":146,"props":167,"children":168},{},[169],{"type":117,"value":170},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":111,"tag":146,"props":172,"children":173},{},[174],{"type":117,"value":175},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":111,"tag":146,"props":177,"children":178},{},[179],{"type":117,"value":180},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":111,"tag":112,"props":182,"children":184},{"id":183},"required-qualifications",[185],{"type":117,"value":186},"Required Qualifications",{"type":111,"tag":142,"props":188,"children":189},{},[190,195,200,205,210,215,220],{"type":111,"tag":146,"props":191,"children":192},{},[193],{"type":117,"value":194},"Upper-intermediate to fluent speaking and writing English. Able to have a real-time conversation.",{"type":111,"tag":146,"props":196,"children":197},{},[198],{"type":117,"value":199},"5+ years of full-time hands-on Python experience.",{"type":111,"tag":146,"props":201,"children":202},{},[203],{"type":117,"value":204},"2+ years of full-time experience in the Healthcare Industry..",{"type":111,"tag":146,"props":206,"children":207},{},[208],{"type":117,"value":209},"1+ years of full-time hands-on HL7/FHIR experience.",{"type":111,"tag":146,"props":211,"children":212},{},[213],{"type":117,"value":214},"1+ years of full-time hands-on AI Development experience.",{"type":111,"tag":146,"props":216,"children":217},{},[218],{"type":117,"value":219},"Capable of digging into systems and learning independently, not completely reliant on AI-assisted coding tools.",{"type":111,"tag":146,"props":221,"children":222},{},[223],{"type":117,"value":224},"Strong understanding of system architecture.",{"type":111,"tag":112,"props":226,"children":228},{"id":227},"nice-to-haves",[229],{"type":117,"value":230},"Nice to haves",{"type":111,"tag":142,"props":232,"children":233},{},[234],{"type":111,"tag":146,"props":235,"children":236},{},[237],{"type":117,"value":238},"Bachelor’s degree in Computer Science or equivalent demonstrated ability.",{"type":111,"tag":112,"props":240,"children":242},{"id":241},"frequently-asked-questions",[243],{"type":117,"value":244},"Frequently Asked Questions",{"type":111,"tag":246,"props":247,"children":248},"blockquote",{},[249],{"type":111,"tag":120,"props":250,"children":251},{},[252],{"type":111,"tag":253,"props":254,"children":255},"em",{},[256],{"type":117,"value":257},"What are your typical clients?",{"type":111,"tag":120,"props":259,"children":260},{},[261],{"type":117,"value":262},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":111,"tag":246,"props":264,"children":265},{},[266],{"type":111,"tag":120,"props":267,"children":268},{},[269],{"type":111,"tag":253,"props":270,"children":271},{},[272],{"type":117,"value":273},"What is the length of your engagements?",{"type":111,"tag":120,"props":275,"children":276},{},[277],{"type":117,"value":278},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":111,"tag":246,"props":280,"children":281},{},[282],{"type":111,"tag":120,"props":283,"children":284},{},[285],{"type":111,"tag":253,"props":286,"children":287},{},[288],{"type":117,"value":289},"What’s your company size?",{"type":111,"tag":120,"props":291,"children":292},{},[293],{"type":117,"value":294},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 410+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":111,"tag":246,"props":296,"children":297},{},[298],{"type":111,"tag":120,"props":299,"children":300},{},[301],{"type":111,"tag":253,"props":302,"children":303},{},[304],{"type":117,"value":305},"What happens if the engagement is completed?",{"type":111,"tag":120,"props":307,"children":308},{},[309],{"type":117,"value":310},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":111,"tag":246,"props":312,"children":313},{},[314],{"type":111,"tag":120,"props":315,"children":316},{},[317],{"type":111,"tag":253,"props":318,"children":319},{},[320],{"type":117,"value":321},"What are your core values?",{"type":111,"tag":120,"props":323,"children":324},{},[325],{"type":117,"value":326},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":111,"tag":120,"props":328,"children":329},{},[330],{"type":117,"value":331},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":111,"tag":120,"props":333,"children":334},{},[335],{"type":117,"value":336},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":8,"searchDepth":19,"depth":19,"links":338},[339,340,341,342,343,344],{"id":114,"depth":19,"text":118},{"id":127,"depth":19,"text":130},{"id":153,"depth":19,"text":156},{"id":183,"depth":19,"text":186},{"id":227,"depth":19,"text":230},{"id":241,"depth":19,"text":244},"content:opportunities:backend-engineer-healthcare-441.md","opportunities/backend-engineer-healthcare-441.md",{"_path":348,"_dir":95,"_draft":7,"_partial":7,"_locale":8,"title":349,"description":8,"draft":7,"tags":350,"related_content":351,"short_title":349,"header_one":352,"header_two":353,"header_three":8,"cta_header":102,"cta_button":103,"cta_href":104,"icon":8,"icons":354,"image_url":8,"hero_image":8,"body":357,"_type":21,"_id":635,"_source":23,"_file":636,"_extension":25},"/opportunities/clinical-terminologist-436","Clinical Terminologist",[98],[],"Clinical","Terminologist",[355,356],"book-open-outline","hospital-box-outline",{"type":16,"children":358,"toc":627},[359,363,368,372,377,382,387,392,425,430,434,453,457,514,518,545,549,559,563,573,577,587,591,601,605,615,619,623],{"type":111,"tag":112,"props":360,"children":361},{"id":114},[362],{"type":117,"value":118},{"type":111,"tag":120,"props":364,"children":365},{},[366],{"type":117,"value":367},"We're looking for a Clinical Terminologist. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":111,"tag":112,"props":369,"children":370},{"id":127},[371],{"type":117,"value":130},{"type":111,"tag":120,"props":373,"children":374},{},[375],{"type":117,"value":376},"Our client is disrupting the clinical trial enrollment process by transforming the way researchers identify eligible patients. Using artificial intelligence and natural language processing to mine structured and unstructured patient data, we find more, better-matching patients for trials in minutes, not months.",{"type":111,"tag":120,"props":378,"children":379},{},[380],{"type":117,"value":381},"We work with some of the most prominent health systems, pharma companies, and CROs in the world, making our platform a crucial step in their clinical research workflow and greatly accelerating patients’ access to clinical trials.",{"type":111,"tag":120,"props":383,"children":384},{},[385],{"type":117,"value":386},"Join the mission to bring life-saving treatments to patients faster with AI in clinical trials.",{"type":111,"tag":120,"props":388,"children":389},{},[390],{"type":117,"value":391},"Responsibilities:",{"type":111,"tag":142,"props":393,"children":394},{},[395,400,405,410,415,420],{"type":111,"tag":146,"props":396,"children":397},{},[398],{"type":117,"value":399},"Collaborate with cross-functional teams to manage and update terminology services made available across the company.",{"type":111,"tag":146,"props":401,"children":402},{},[403],{"type":117,"value":404},"Maintain and extend modeled ontology solutions used throughout the company.",{"type":111,"tag":146,"props":406,"children":407},{},[408],{"type":117,"value":409},"Standardize clinical concepts from a variety of sources, including our client curated data, EHR integrations, and lab systems.",{"type":111,"tag":146,"props":411,"children":412},{},[413],{"type":117,"value":414},"Manage the adjudication of, and quality control pipelines for, new clinical concepts and domains.",{"type":111,"tag":146,"props":416,"children":417},{},[418],{"type":117,"value":419},"Proactively monitor and support quality assurance and process improvement initiatives.",{"type":111,"tag":146,"props":421,"children":422},{},[423],{"type":117,"value":424},"Monitor performance of production processes and recommend areas for improvement.",{"type":111,"tag":120,"props":426,"children":427},{},[428],{"type":117,"value":429},"Availability: Full-time.",{"type":111,"tag":112,"props":431,"children":432},{"id":153},[433],{"type":117,"value":156},{"type":111,"tag":158,"props":435,"children":436},{},[437,441,445,449],{"type":111,"tag":146,"props":438,"children":439},{},[440],{"type":117,"value":165},{"type":111,"tag":146,"props":442,"children":443},{},[444],{"type":117,"value":170},{"type":111,"tag":146,"props":446,"children":447},{},[448],{"type":117,"value":175},{"type":111,"tag":146,"props":450,"children":451},{},[452],{"type":117,"value":180},{"type":111,"tag":112,"props":454,"children":455},{"id":183},[456],{"type":117,"value":186},{"type":111,"tag":142,"props":458,"children":459},{},[460,464,469,474,479,484,489,494,499,504,509],{"type":111,"tag":146,"props":461,"children":462},{},[463],{"type":117,"value":194},{"type":111,"tag":146,"props":465,"children":466},{},[467],{"type":117,"value":468},"3+ years of full-time hands-on Data Analyst / Clinical Terminologyst experience.",{"type":111,"tag":146,"props":470,"children":471},{},[472],{"type":117,"value":473},"3+ years of experience with Medical terminologies (ICD-CM-9/10, SNOMED CT, RxNorm, LOINC, CPT).",{"type":111,"tag":146,"props":475,"children":476},{},[477],{"type":117,"value":478},"3+ years of full-time hands-on Python experience.",{"type":111,"tag":146,"props":480,"children":481},{},[482],{"type":117,"value":483},"3+ years of full-time hands-on SQL experience.",{"type":111,"tag":146,"props":485,"children":486},{},[487],{"type":117,"value":488},"1+ year of full-time hands-on HL7/FHIR experience.",{"type":111,"tag":146,"props":490,"children":491},{},[492],{"type":117,"value":493},"UMLS & NCIm familiarity.",{"type":111,"tag":146,"props":495,"children":496},{},[497],{"type":117,"value":498},"Clinical ontology development/maintenance experience.",{"type":111,"tag":146,"props":500,"children":501},{},[502],{"type":117,"value":503},"Real-world data pipeline work (EHRs, labs, claims, abstraction).",{"type":111,"tag":146,"props":505,"children":506},{},[507],{"type":117,"value":508},"ELT tools, SQL, Python, semantic web stack (RDF, OWL, SPARQL).",{"type":111,"tag":146,"props":510,"children":511},{},[512],{"type":117,"value":513},"HL7/FHIR awareness.",{"type":111,"tag":112,"props":515,"children":516},{"id":227},[517],{"type":117,"value":230},{"type":111,"tag":142,"props":519,"children":520},{},[521,526,531,536,541],{"type":111,"tag":146,"props":522,"children":523},{},[524],{"type":117,"value":525},"Clinical background (PA, NP, RN).",{"type":111,"tag":146,"props":527,"children":528},{},[529],{"type":117,"value":530},"RWD analysis in Python/SQL.",{"type":111,"tag":146,"props":532,"children":533},{},[534],{"type":117,"value":535},"Professional org involvement (OHDSI, AMIA).",{"type":111,"tag":146,"props":537,"children":538},{},[539],{"type":117,"value":540},"OMOP Common Data Model experience.",{"type":111,"tag":146,"props":542,"children":543},{},[544],{"type":117,"value":238},{"type":111,"tag":112,"props":546,"children":547},{"id":241},[548],{"type":117,"value":244},{"type":111,"tag":246,"props":550,"children":551},{},[552],{"type":111,"tag":120,"props":553,"children":554},{},[555],{"type":111,"tag":253,"props":556,"children":557},{},[558],{"type":117,"value":257},{"type":111,"tag":120,"props":560,"children":561},{},[562],{"type":117,"value":262},{"type":111,"tag":246,"props":564,"children":565},{},[566],{"type":111,"tag":120,"props":567,"children":568},{},[569],{"type":111,"tag":253,"props":570,"children":571},{},[572],{"type":117,"value":273},{"type":111,"tag":120,"props":574,"children":575},{},[576],{"type":117,"value":278},{"type":111,"tag":246,"props":578,"children":579},{},[580],{"type":111,"tag":120,"props":581,"children":582},{},[583],{"type":111,"tag":253,"props":584,"children":585},{},[586],{"type":117,"value":289},{"type":111,"tag":120,"props":588,"children":589},{},[590],{"type":117,"value":294},{"type":111,"tag":246,"props":592,"children":593},{},[594],{"type":111,"tag":120,"props":595,"children":596},{},[597],{"type":111,"tag":253,"props":598,"children":599},{},[600],{"type":117,"value":305},{"type":111,"tag":120,"props":602,"children":603},{},[604],{"type":117,"value":310},{"type":111,"tag":246,"props":606,"children":607},{},[608],{"type":111,"tag":120,"props":609,"c