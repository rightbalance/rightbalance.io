[{"data":1,"prerenderedAt":935},["Reactive",2],{"opportunities-element-bigcommerce-fullstack-467":3,"opportunities":366},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"draft":6,"tags":9,"related_content":11,"short_title":8,"header_one":12,"header_two":13,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":17,"image_url":7,"hero_image":7,"body":19,"_type":361,"_id":362,"_source":363,"_file":364,"_extension":365},"/opportunities/bigcommerce-fullstack-467","opportunities",false,"","BigCommerce Fullstack Engineer",[10],"oportunity",[],"Fullstack Engineer","Bigcommerce","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrWu1M0aA9QTvTVF",[18],"cart-outline",{"type":20,"children":21,"toc":352},"root",[22,31,37,43,48,53,58,103,108,131,136,142,166,172,215,221,254,260,273,278,289,294,305,310,321,326,337,342,347],{"type":23,"tag":24,"props":25,"children":27},"element","h2",{"id":26},"overview",[28],{"type":29,"value":30},"text","Overview",{"type":23,"tag":32,"props":33,"children":34},"p",{},[35],{"type":29,"value":36},"We're looking for a BigCommerce Fullstack Engineer. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":23,"tag":24,"props":38,"children":40},{"id":39},"client-engagement-details",[41],{"type":29,"value":42},"Client Engagement Details",{"type":23,"tag":32,"props":44,"children":45},{},[46],{"type":29,"value":47},"Our client is a family-run luxury home furnishings e-commerce retailer built on three generations and 85+ years of industry experience, offering a curated range of traditional, transitional, and modern furniture, lighting, decor, rugs, and dining essentials across every room in the home. Backed by partnerships with respected design-trade brands and run by a team of creatives and interior enthusiasts, they help customers turn houses into homes that reflect their lifestyle and personality; combining trade-level expertise with an easy, one-stop shopping experience.",{"type":23,"tag":32,"props":49,"children":50},{},[51],{"type":29,"value":52},"Overview\nWe're looking for a Mid-Level BigCommerce Full Stack Engineer with strong technical fundamentals and hands-on experience building and maintaining ecommerce storefronts.\nThe primary focus will be on supporting and extending the client's BigCommerce-based storefront, working alongside the design team to bring refined, premium ecommerce experiences to life through solid, maintainable code.\nThe candidate should be technically strong, comfortable owning both frontend and backend work, and able to collaborate closely with a designer to implement polished, ecommerce-focused features.\nRole context: The BigCommerce storefront will be the immediate priority, supporting ongoing development and refinement of the site's frontend and backend functionality, including catalog, checkout, and integration work. The engineer will work closely with the design team to implement visual and UX improvements as the site is elevated toward a premium, luxury-oriented customer experience.",{"type":23,"tag":32,"props":54,"children":55},{},[56],{"type":29,"value":57},"Key Responsibilities",{"type":23,"tag":59,"props":60,"children":61},"ul",{},[62,68,73,78,83,88,93,98],{"type":23,"tag":63,"props":64,"children":65},"li",{},[66],{"type":29,"value":67},"Build and maintain the BigCommerce storefront, including Stencil theme development and customization",{"type":23,"tag":63,"props":69,"children":70},{},[71],{"type":29,"value":72},"Implement designs delivered by the design team into functional, production-ready code",{"type":23,"tag":63,"props":74,"children":75},{},[76],{"type":29,"value":77},"Develop and maintain integrations with third-party systems (vendor feeds, back-office tools, payment/shipping providers)",{"type":23,"tag":63,"props":79,"children":80},{},[81],{"type":29,"value":82},"Manage catalog structure and inventory sync across a large, multi-category product range",{"type":23,"tag":63,"props":84,"children":85},{},[86],{"type":29,"value":87},"Troubleshoot checkout flow, product configuration logic, and site performance issues",{"type":23,"tag":63,"props":89,"children":90},{},[91],{"type":29,"value":92},"Use Claude Code as part of the standard development workflow for building features, debugging, and code review",{"type":23,"tag":63,"props":94,"children":95},{},[96],{"type":29,"value":97},"Collaborate closely with the designer to ensure design intent is technically feasible and faithfully implemented",{"type":23,"tag":63,"props":99,"children":100},{},[101],{"type":29,"value":102},"Maintain and evolve the site's component library/design system from a technical standpoint",{"type":23,"tag":32,"props":104,"children":105},{},[106],{"type":29,"value":107},"Tools",{"type":23,"tag":59,"props":109,"children":110},{},[111,116,121,126],{"type":23,"tag":63,"props":112,"children":113},{},[114],{"type":29,"value":115},"BigCommerce (Stencil, Storefront/Management APIs)",{"type":23,"tag":63,"props":117,"children":118},{},[119],{"type":29,"value":120},"Claude Code",{"type":23,"tag":63,"props":122,"children":123},{},[124],{"type":29,"value":125},"Git-based version control",{"type":23,"tag":63,"props":127,"children":128},{},[129],{"type":29,"value":130},"Figma (for reference, to implement designer handoffs)",{"type":23,"tag":32,"props":132,"children":133},{},[134],{"type":29,"value":135},"Availability: Project-based, 20–25 hours per week.",{"type":23,"tag":24,"props":137,"children":139},{"id":138},"whats-in-it-for-you",[140],{"type":29,"value":141},"What’s in it for you",{"type":23,"tag":143,"props":144,"children":145},"ol",{},[146,151,156,161],{"type":23,"tag":63,"props":147,"children":148},{},[149],{"type":29,"value":150},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":23,"tag":63,"props":152,"children":153},{},[154],{"type":29,"value":155},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":23,"tag":63,"props":157,"children":158},{},[159],{"type":29,"value":160},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":23,"tag":63,"props":162,"children":163},{},[164],{"type":29,"value":165},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":23,"tag":24,"props":167,"children":169},{"id":168},"required-qualifications",[170],{"type":29,"value":171},"Required Qualifications",{"type":23,"tag":59,"props":173,"children":174},{},[175,180,185,190,195,200,205,210],{"type":23,"tag":63,"props":176,"children":177},{},[178],{"type":29,"value":179},"Upper-intermediate to fluent speaking and writing English. Able to have a real-time conversation.",{"type":23,"tag":63,"props":181,"children":182},{},[183],{"type":29,"value":184},"Full-time hands-on BigCommerce development experience (mid-level, roughly 3+ years).",{"type":23,"tag":63,"props":186,"children":187},{},[188],{"type":29,"value":189},"Full-time hands-on full stack development experience, front end and back end.",{"type":23,"tag":63,"props":191,"children":192},{},[193],{"type":29,"value":194},"Hands-on experience with Claude Code or comparable AI-assisted development tools.",{"type":23,"tag":63,"props":196,"children":197},{},[198],{"type":29,"value":199},"Strong understanding of ecommerce functionality and customer-facing digital experiences.",{"type":23,"tag":63,"props":201,"children":202},{},[203],{"type":29,"value":204},"Experience working within an existing technical environment alongside a designer.",{"type":23,"tag":63,"props":206,"children":207},{},[208],{"type":29,"value":209},"Ability to work independently and take ownership of technical implementation.",{"type":23,"tag":63,"props":211,"children":212},{},[213],{"type":29,"value":214},"Strong experience incorporating AI-assisted tools into the development workflow.",{"type":23,"tag":24,"props":216,"children":218},{"id":217},"nice-to-haves",[219],{"type":29,"value":220},"Nice to haves",{"type":23,"tag":59,"props":222,"children":223},{},[224,229,234,239,244,249],{"type":23,"tag":63,"props":225,"children":226},{},[227],{"type":29,"value":228},"Experience with headless ecommerce environments.",{"type":23,"tag":63,"props":230,"children":231},{},[232],{"type":29,"value":233},"Experience working with luxury or premium ecommerce brands.",{"type":23,"tag":63,"props":235,"children":236},{},[237],{"type":29,"value":238},"Experience with configurable/variant product catalogs (fabric, finish, size, dimensions).",{"type":23,"tag":63,"props":240,"children":241},{},[242],{"type":29,"value":243},"Familiarity with design systems and component libraries from a technical implementation standpoint.",{"type":23,"tag":63,"props":245,"children":246},{},[247],{"type":29,"value":248},"Experience integrating payment gateways or shipping providers.",{"type":23,"tag":63,"props":250,"children":251},{},[252],{"type":29,"value":253},"Bachelor’s degree in Computer Science or equivalent demonstrated ability.",{"type":23,"tag":24,"props":255,"children":257},{"id":256},"frequently-asked-questions",[258],{"type":29,"value":259},"Frequently Asked Questions",{"type":23,"tag":261,"props":262,"children":263},"blockquote",{},[264],{"type":23,"tag":32,"props":265,"children":266},{},[267],{"type":23,"tag":268,"props":269,"children":270},"em",{},[271],{"type":29,"value":272},"What are your typical clients?",{"type":23,"tag":32,"props":274,"children":275},{},[276],{"type":29,"value":277},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":23,"tag":261,"props":279,"children":280},{},[281],{"type":23,"tag":32,"props":282,"children":283},{},[284],{"type":23,"tag":268,"props":285,"children":286},{},[287],{"type":29,"value":288},"What is the length of your engagements?",{"type":23,"tag":32,"props":290,"children":291},{},[292],{"type":29,"value":293},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":23,"tag":261,"props":295,"children":296},{},[297],{"type":23,"tag":32,"props":298,"children":299},{},[300],{"type":23,"tag":268,"props":301,"children":302},{},[303],{"type":29,"value":304},"What’s your company size?",{"type":23,"tag":32,"props":306,"children":307},{},[308],{"type":29,"value":309},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 20+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":23,"tag":261,"props":311,"children":312},{},[313],{"type":23,"tag":32,"props":314,"children":315},{},[316],{"type":23,"tag":268,"props":317,"children":318},{},[319],{"type":29,"value":320},"What happens if the engagement is completed?",{"type":23,"tag":32,"props":322,"children":323},{},[324],{"type":29,"value":325},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":23,"tag":261,"props":327,"children":328},{},[329],{"type":23,"tag":32,"props":330,"children":331},{},[332],{"type":23,"tag":268,"props":333,"children":334},{},[335],{"type":29,"value":336},"What are your core values?",{"type":23,"tag":32,"props":338,"children":339},{},[340],{"type":29,"value":341},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":23,"tag":32,"props":343,"children":344},{},[345],{"type":29,"value":346},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":23,"tag":32,"props":348,"children":349},{},[350],{"type":29,"value":351},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":7,"searchDepth":353,"depth":353,"links":354},2,[355,356,357,358,359,360],{"id":26,"depth":353,"text":30},{"id":39,"depth":353,"text":42},{"id":138,"depth":353,"text":141},{"id":168,"depth":353,"text":171},{"id":217,"depth":353,"text":220},{"id":256,"depth":353,"text":259},"markdown","content:opportunities:bigcommerce-fullstack-467.md","content","opportunities/bigcommerce-fullstack-467.md","md",[367,642],{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"draft":6,"tags":368,"related_content":369,"short_title":8,"header_one":12,"header_two":13,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":370,"image_url":7,"hero_image":7,"body":371,"_type":361,"_id":362,"_source":363,"_file":364,"_extension":365},[10],[],[18],{"type":20,"children":372,"toc":634},[373,377,381,385,389,393,397,432,436,455,459,463,482,486,521,525,552,556,566,570,580,584,594,598,608,612,622,626,630],{"type":23,"tag":24,"props":374,"children":375},{"id":26},[376],{"type":29,"value":30},{"type":23,"tag":32,"props":378,"children":379},{},[380],{"type":29,"value":36},{"type":23,"tag":24,"props":382,"children":383},{"id":39},[384],{"type":29,"value":42},{"type":23,"tag":32,"props":386,"children":387},{},[388],{"type":29,"value":47},{"type":23,"tag":32,"props":390,"children":391},{},[392],{"type":29,"value":52},{"type":23,"tag":32,"props":394,"children":395},{},[396],{"type":29,"value":57},{"type":23,"tag":59,"props":398,"children":399},{},[400,404,408,412,416,420,424,428],{"type":23,"tag":63,"props":401