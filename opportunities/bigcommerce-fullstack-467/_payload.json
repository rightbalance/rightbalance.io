ldren":596},{},[597],{"type":29,"value":309},{"type":23,"tag":261,"props":599,"children":600},{},[601],{"type":23,"tag":32,"props":602,"children":603},{},[604],{"type":23,"tag":268,"props":605,"children":606},{},[607],{"type":29,"value":320},{"type":23,"tag":32,"props":609,"children":610},{},[611],{"type":29,"value":325},{"type":23,"tag":261,"props":613,"children":614},{},[615],{"type":23,"tag":32,"props":616,"children":617},{},[618],{"type":23,"tag":268,"props":619,"children":620},{},[621],{"type":29,"value":336},{"type":23,"tag":32,"props":623,"children":624},{},[625],{"type":29,"value":341},{"type":23,"tag":32,"props":627,"children":628},{},[629],{"type":29,"value":346},{"type":23,"tag":32,"props":631,"children":632},{},[633],{"type":29,"value":351},{"title":7,"searchDepth":353,"depth":353,"links":635},[636,637,638,639,640,641],{"id":26,"depth":353,"text":30},{"id":39,"depth":353,"text":42},{"id":138,"depth":353,"text":141},{"id":168,"depth":353,"text":171},{"id":217,"depth":353,"text":220},{"id":256,"depth":353,"text":259},{"_path":643,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":644,"description":7,"draft":6,"tags":645,"related_content":646,"short_title":644,"header_one":647,"header_two":648,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":649,"image_url":7,"hero_image":7,"body":652,"_type":361,"_id":933,"_source":363,"_file":934,"_extension":365},"/opportunities/shopify-ecommerce-coordinator-460","Shopify Ecommerce Experience Coordinator",[10],[],"Shopify Ecommerce","Experience Coordinator",[650,651],"account-group","shopping-outline",{"type":20,"children":653,"toc":925},[654,658,663,667,672,677,682,730,735,739,758,762,810,814,842,846,856,860,870,874,884,889,899,903,913,917,921],{"type":23,"tag":24,"props":655,"children":656},{"id":26},[657],{"type":29,"value":30},{"type":23,"tag":32,"props":659,"children":660},{},[661],{"type":29,"value":662},"We're looking for a Shopify Ecommerce Experience Coordinator. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":23,"tag":24,"props":664,"children":665},{"id":39},[666],{"type":29,"value":42},{"type":23,"tag":32,"props":668,"children":669},{},[670],{"type":29,"value":671},"Our client is a fast-growing, natural personal-care brand with a high-traffic Shopify storefront and a rapidly expanding retail presence. You'll own and optimize the day-to-day ecommerce experience across their storefront. This role goes beyond content management: it combines merchandising, ecommerce operations, experimentation, and analytics to continuously improve the customer journey and drive conversion.",{"type":23,"tag":32,"props":673,"children":674},{},[675],{"type":29,"value":676},"The ideal candidate is analytical, detail-oriented, and comfortable making data-driven decisions based on user behavior, A/B testing, and ecommerce performance insights.",{"type":23,"tag":32,"props":678,"children":679},{},[680],{"type":29,"value":681},"What You’ll Do:",{"type":23,"tag":59,"props":683,"children":684},{},[685,690,695,700,705,710,715,720,725],{"type":23,"tag":63,"props":686,"children":687},{},[688],{"type":29,"value":689},"Own and manage all content launches across the Shopify storefront.",{"type":23,"tag":63,"props":691,"children":692},{},[693],{"type":29,"value":694},"Manage and maintain Shopify Admin, including products, collections, tags, and inventory.",{"type":23,"tag":63,"props":696,"children":697},{},[698],{"type":29,"value":699},"Coordinate product launches and merchandising initiatives.",{"type":23,"tag":63,"props":701,"children":702},{},[703],{"type":29,"value":704},"Create and update landing pages.",{"type":23,"tag":63,"props":706,"children":707},{},[708],{"type":29,"value":709},"Support SEO optimization efforts.",{"type":23,"tag":63,"props":711,"children":712},{},[713],{"type":29,"value":714},"Plan, execute, and monitor A/B testing initiatives.",{"type":23,"tag":63,"props":716,"children":717},{},[718],{"type":29,"value":719},"Analyze customer behavior and ecommerce funnel performance to identify optimization opportunities.",{"type":23,"tag":63,"props":721,"children":722},{},[723],{"type":29,"value":724},"Make strategic recommendations based on data and user insights.",{"type":23,"tag":63,"props":726,"children":727},{},[728],{"type":29,"value":729},"Collaborate with cross-functional teams to continuously improve the online shopping experience.",{"type":23,"tag":32,"props":731,"children":732},{},[733],{"type":29,"value":734},"Availability: Part-time hours. Long-term engagement with the potential to scale to full-time",{"type":23,"tag":24,"props":736,"children":737},{"id":138},[738],{"type":29,"value":141},{"type":23,"tag":143,"props":740,"children":741},{},[742,746,750,754],{"type":23,"tag":63,"props":743,"children":744},{},[745],{"type":29,"value":150},{"type":23,"tag":63,"props":747,"children":748},{},[749],{"type":29,"value":155},{"type":23,"tag":63,"props":751,"children":752},{},[753],{"type":29,"value":160},{"type":23,"tag":63,"props":755,"children":756},{},[757],{"type":29,"value":165},{"type":23,"tag":24,"props":759,"children":760},{"id":168},[761],{"type":29,"value":171},{"type":23,"tag":59,"props":763,"children":764},{},[765,770,775,780,785,790,795,800,805],{"type":23,"tag":63,"props":766,"children":767},{},[768],{"type":29,"value":769},"Advanced to fluent speaking and writing English. Able to have a real-time conversation.",{"type":23,"tag":63,"props":771,"children":772},{},[773],{"type":29,"value":774},"3+ years managing Shopify storefronts.",{"type":23,"tag":63,"props":776,"children":777},{},[778],{"type":29,"value":779},"3+ years in ecommerce operations and merchandising.",{"type":23,"tag":63,"props":781,"children":782},{},[783],{"type":29,"value":784},"2+ years coordinating content and product launches.",{"type":23,"tag":63,"props":786,"children":787},{},[788],{"type":29,"value":78