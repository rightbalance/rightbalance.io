[{"data":1,"prerenderedAt":1614},["Reactive",2],{"opportunities-element-data-modeler-434":3,"opportunities":347},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"draft":6,"tags":9,"related_content":11,"short_title":8,"header_one":12,"header_two":13,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":17,"image_url":7,"hero_image":7,"body":20,"_type":342,"_id":343,"_source":344,"_file":345,"_extension":346},"/opportunities/data-modeler-434","opportunities",false,"","Data Modeler - FHIR/OMOP",[10],"oportunity",[],"Data Modeler","FHIR/OMOP","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrn4RALUBunWkfJd",[18,19],"database-cog","hospital-box-outline",{"type":21,"children":22,"toc":333},"root",[23,32,38,44,49,54,59,64,109,114,122,128,152,158,201,207,235,241,254,259,270,275,286,291,302,307,318,323,328],{"type":24,"tag":25,"props":26,"children":28},"element","h2",{"id":27},"overview",[29],{"type":30,"value":31},"text","Overview",{"type":24,"tag":33,"props":34,"children":35},"p",{},[36],{"type":30,"value":37},"We're looking for a Data Modeler - FHIR/OMOP. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":39,"children":41},{"id":40},"client-engagement-details",[42],{"type":30,"value":43},"Client Engagement Details",{"type":24,"tag":33,"props":45,"children":46},{},[47],{"type":30,"value":48},"They're disrupting the clinical trial enrollment process by transforming the way researchers identify eligible patients. Using artificial intelligence and natural language processing to mine structured and unstructured patient data, we find more, better-matching patients for trials in minutes, not months.",{"type":24,"tag":33,"props":50,"children":51},{},[52],{"type":30,"value":53},"They work with some of the most prominent health systems, pharma companies, and CROs in the world, making our platform a crucial step in their clinical research workflow and greatly accelerating patients’ access to clinical trials.",{"type":24,"tag":33,"props":55,"children":56},{},[57],{"type":30,"value":58},"Join the mission to bring life-saving treatments to patients faster with AI in clinical trials.",{"type":24,"tag":33,"props":60,"children":61},{},[62],{"type":30,"value":63},"Responsibilities:",{"type":24,"tag":65,"props":66,"children":67},"ul",{},[68,74,79,84,89,94,99,104],{"type":24,"tag":69,"props":70,"children":71},"li",{},[72],{"type":30,"value":73},"Collaborate with cross-functional teams including medical oncologists, research scientists, and engineers to develop and maintain clinical data models.",{"type":24,"tag":69,"props":75,"children":76},{},[77],{"type":30,"value":78},"Translate customer needs and product requests into key concept definitions and business logic for complex models.",{"type":24,"tag":69,"props":80,"children":81},{},[82],{"type":30,"value":83},"Facilitate integration of data model into workflows, applications, and data deliveries.",{"type":24,"tag":69,"props":85,"children":86},{},[87],{"type":30,"value":88},"Structure and normalize data from a variety of sources, including internal curated data, EHR integrations, and lab systems.",{"type":24,"tag":69,"props":90,"children":91},{},[92],{"type":30,"value":93},"Develop and maintain knowledge bases for clinical concepts.",{"type":24,"tag":69,"props":95,"children":96},{},[97],{"type":30,"value":98},"Create and execute validation plans in conjunction with SMEs for new models and disease types.",{"type":24,"tag":69,"props":100,"children":101},{},[102],{"type":30,"value":103},"Proactively monitor and support quality assurance and process improvement initiatives.",{"type":24,"tag":69,"props":105,"children":106},{},[107],{"type":30,"value":108},"Monitor performance of production processes and recommend areas for improvement.",{"type":24,"tag":33,"props":110,"children":111},{},[112],{"type":30,"value":113},"Availability: Full-time.",{"type":24,"tag":65,"props":115,"children":116},{},[117],{"type":24,"tag":69,"props":118,"children":119},{},[120],{"type":30,"value":121},"6+ months contract (with option to extend).",{"type":24,"tag":25,"props":123,"children":125},{"id":124},"whats-in-it-for-you",[126],{"type":30,"value":127},"What’s in it for you",{"type":24,"tag":129,"props":130,"children":131},"ol",{},[132,137,142,147],{"type":24,"tag":69,"props":133,"children":134},{},[135],{"type":30,"value":136},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":24,"tag":69,"props":138,"children":139},{},[140],{"type":30,"value":141},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":24,"tag":69,"props":143,"children":144},{},[145],{"type":30,"value":146},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":24,"tag":69,"props":148,"children":149},{},[150],{"type":30,"value":151},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":24,"tag":25,"props":153,"children":155},{"id":154},"required-qualifications",[156],{"type":30,"value":157},"Required Qualifications",{"type":24,"tag":65,"props":159,"children":160},{},[161,166,171,176,181,186,191,196],{"type":24,"tag":69,"props":162,"children":163},{},[164],{"type":30,"value":165},"Upper-intermediate to fluent speaking and writing English. Able to have a real-time conversation.",{"type":24,"tag":69,"props":167,"children":168},{},[169],{"type":30,"value":170},"5+ years of full-time hands-on Data Engineer/Modeler experience.",{"type":24,"tag":69,"props":172,"children":173},{},[174],{"type":30,"value":175},"3+ years of full-time hands-on ELT tools/DBT experience.",{"type":24,"tag":69,"props":177,"children":178},{},[179],{"type":30,"value":180},"2+ years of full-time hands-on FHIR/OMOP experience.",{"type":24,"tag":69,"props":182,"children":183},{},[184],{"type":30,"value":185},"Background with EHR data and using it for secondary purposes, specifically experience with mapping data into OMOP or using Smart on FHIR apps.",{"type":24,"tag":69,"props":187,"children":188},{},[189],{"type":30,"value":190},"Experience working with real world data from various sources (e.g., curation workflows, EHRs, lab systems, claims, research datasets).",{"type":24,"tag":69,"props":192,"children":193},{},[194],{"type":30,"value":195},"Experience working with modern ELT tools such as DBT to maintain high volume, high velocity data warehouses",{"type":24,"tag":69,"props":197,"children":198},{},[199],{"type":30,"value":200},"Experience working with standard medical terminologies (e.g., SNOMED CT, RxNorm, LOINC, ICD-9/10).",{"type":24,"tag":25,"props":202,"children":204},{"id":203},"nice-to-haves",[205],{"type":30,"value":206},"Nice to haves",{"type":24,"tag":65,"props":208,"children":209},{},[210,215,220,225,230],{"type":24,"tag":69,"props":211,"children":212},{},[213],{"type":30,"value":214},"Clinical background (MD/DO, PharmD, PA, NP, RN, etc.).",{"type":24,"tag":69,"props":216,"children":217},{},[218],{"type":30,"value":219},"Familiarity with next-generation sequencing data.",{"type":24,"tag":69,"props":221,"children":222},{},[223],{"type":30,"value":224},"Experience with real world data analysis in Python or R.",{"type":24,"tag":69,"props":226,"children":227},{},[228],{"type":30,"value":229},"Participation in professional organizations (e.g., OHDSI, AMIA).",{"type":24,"tag":69,"props":231,"children":232},{},[233],{"type":30,"value":234},"Bachelor’s degree in Computer Science or equivalent demonstrated ability.",{"type":24,"tag":25,"props":236,"children":238},{"id":237},"frequently-asked-questions",[239],{"type":30,"value":240},"Frequently Asked Questions",{"type":24,"tag":242,"props":243,"children":244},"blockquote",{},[245],{"type":24,"tag":33,"props":246,"children":247},{},[248],{"type":24,"tag":249,"props":250,"children":251},"em",{},[252],{"type":30,"value":253},"What are your typical clients?",{"type":24,"tag":33,"props":255,"children":256},{},[257],{"type":30,"value":258},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":24,"tag":242,"props":260,"children":261},{},[262],{"type":24,"tag":33,"props":263,"children":264},{},[265],{"type":24,"tag":249,"props":266,"children":267},{},[268],{"type":30,"value":269},"What is the length of your engagements?",{"type":24,"tag":33,"props":271,"children":272},{},[273],{"type":30,"value":274},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":24,"tag":242,"props":276,"children":277},{},[278],{"type":24,"tag":33,"props":279,"children":280},{},[281],{"type":24,"tag":249,"props":282,"children":283},{},[284],{"type":30,"value":285},"What’s your company size?",{"type":24,"tag":33,"props":287,"children":288},{},[289],{"type":30,"value":290},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 410+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":24,"tag":242,"props":292,"children":293},{},[294],{"type":24,"tag":33,"props":295,"children":296},{},[297],{"type":24,"tag":249,"props":298,"children":299},{},[300],{"type":30,"value":301},"What happens if the engagement is completed?",{"type":24,"tag":33,"props":303,"children":304},{},[305],{"type":30,"value":306},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":24,"tag":242,"props":308,"children":309},{},[310],{"type":24,"tag":33,"props":311,"children":312},{},[313],{"type":24,"tag":249,"props":314,"children":315},{},[316],{"type":30,"value":317},"What are your core values?",{"type":24,"tag":33,"props":319,"children":320},{},[321],{"type":30,"value":322},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":24,"tag":33,"props":324,"children":325},{},[326],{"type":30,"value":327},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":24,"tag":33,"props":329,"children":330},{},[331],{"type":30,"value":332},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":7,"searchDepth":334,"depth":334,"links":335},2,[336,337,338,339,340,341],{"id":27,"depth":334,"text":31},{"id":40,"depth":334,"text":43},{"id":124,"depth":334,"text":127},{"id":154,"depth":334,"text":157},{"id":203,"depth":334,"text":206},{"id":237,"depth":334,"text":240},"markdown","content:opportunities:data-modeler-434.md","content","opportunities/data-modeler-434.md","md",[348,558,842,1144,1403],{"_path":349,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":350,"description":7,"draft":6,"tags":351,"related_content":352,"short_title":350,"header_one":353,"header_two":354,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":355,"image_url":7,"hero_image":7,"body":358,"_type":342,"_id":556,"_source":344,"_file":557,"_extension":346},"/opportunities/backend-engineer-healthcare-441","Backend Engineer (Healthcare)",[10],[],"Backend Engineer","Healthcare",[356,357],"language-python","bottle-tonic-plus",{"type":21,"children":359,"toc":548},[360,364,369,373,378,383,3