integrations, and lab systems.",{"type":24,"tag":69,"props":409,"children":410},{},[411],{"type":30,"value":412},"Manage the adjudication of, and quality control pipelines for, new clinical concepts and domains.",{"type":24,"tag":69,"props":414,"children":415},{},[416],{"type":30,"value":103},{"type":24,"tag":69,"props":418,"children":419},{},[420],{"type":30,"value":108},{"type":24,"tag":33,"props":422,"children":423},{},[424],{"type":30,"value":113},{"type":24,"tag":25,"props":426,"children":427},{"id":124},[428],{"type":30,"value":127},{"type":24,"tag":129,"props":430,"children":431},{},[432,436,440,444],{"type":24,"tag":69,"props":433,"children":434},{},[435],{"type":30,"value":136},{"type":24,"tag":69,"props":437,"children":438},{},[439],{"type":30,"value":141},{"type":24,"tag":69,"props":441,"children":442},{},[443],{"type":30,"value":146},{"type":24,"tag":69,"props":445,"children":446},{},[447],{"type":30,"value":151},{"type":24,"tag":25,"props":449,"children":450},{"id":154},[451],{"type":30,"value":157},{"type":24,"tag":65,"props":453,"children":454},{},[455,459,464,469,474,479,484,489,494,499,504],{"type":24,"tag":69,"props":456,"children":457},{},[458],{"type":30,"value":165},{"type":24,"tag":69,"props":460,"children":461},{},[462],{"type":30,"value":463},"3+ years of full-time hands-on Data Analyst / Clinical Terminologyst experience.",{"type":24,"tag":69,"props":465,"children":466},{},[467],{"type":30,"value":468},"3+ years of experience with Medical terminologies (ICD-CM-9/10, SNOMED CT, RxNorm, LOINC, CPT).",{"type":24,"tag":69,"props":470,"children":471},{},[472],{"type":30,"value":473},"3+ years of full-time hands-on Python experience.",{"type":24,"tag":69,"props":475,"children":476},{},[477],{"type":30,"value":478},"3+ years of full-time hands-on SQL experience.",{"type":24,"tag":69,"props":480,"children":481},{},[482],{"type":30,"value":483},"1+ year of full-time hands-on HL7/FHIR experience.",{"type":24,"tag":69,"props":485,"children":486},{},[48