[{"data":1,"prerenderedAt":1190},["Reactive",2],{"opportunities-element-shopify-ecommerce-coordinator-460":3,"opportunities":344},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"draft":6,"tags":9,"related_content":11,"short_title":8,"header_one":12,"header_two":13,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":17,"image_url":7,"hero_image":7,"body":20,"_type":339,"_id":340,"_source":341,"_file":342,"_extension":343},"/opportunities/shopify-ecommerce-coordinator-460","opportunities",false,"","Shopify Ecommerce Experience Coordinator",[10],"oportunity",[],"Shopify Ecommerce","Experience Coordinator","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrWu1M0aA9QTvTVF",[18,19],"account-group","shopping-outline",{"type":21,"children":22,"toc":330},"root",[23,32,38,44,49,54,59,109,114,120,144,150,198,204,232,238,251,256,267,272,283,288,299,304,315,320,325],{"type":24,"tag":25,"props":26,"children":28},"element","h2",{"id":27},"overview",[29],{"type":30,"value":31},"text","Overview",{"type":24,"tag":33,"props":34,"children":35},"p",{},[36],{"type":30,"value":37},"We're looking for a Shopify Ecommerce Experience Coordinator. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":39,"children":41},{"id":40},"client-engagement-details",[42],{"type":30,"value":43},"Client Engagement Details",{"type":24,"tag":33,"props":45,"children":46},{},[47],{"type":30,"value":48},"Our client is a fast-growing, natural personal-care brand with a high-traffic Shopify storefront and a rapidly expanding retail presence. You'll own and optimize the day-to-day ecommerce experience across their storefront. This role goes beyond content management: it combines merchandising, ecommerce operations, experimentation, and analytics to continuously improve the customer journey and drive conversion.",{"type":24,"tag":33,"props":50,"children":51},{},[52],{"type":30,"value":53},"The ideal candidate is analytical, detail-oriented, and comfortable making data-driven decisions based on user behavior, A/B testing, and ecommerce performance insights.",{"type":24,"tag":33,"props":55,"children":56},{},[57],{"type":30,"value":58},"What You’ll Do:",{"type":24,"tag":60,"props":61,"children":62},"ul",{},[63,69,74,79,84,89,94,99,104],{"type":24,"tag":64,"props":65,"children":66},"li",{},[67],{"type":30,"value":68},"Own and manage all content launches across the Shopify storefront.",{"type":24,"tag":64,"props":70,"children":71},{},[72],{"type":30,"value":73},"Manage and maintain Shopify Admin, including products, collections, tags, and inventory.",{"type":24,"tag":64,"props":75,"children":76},{},[77],{"type":30,"value":78},"Coordinate product launches and merchandising initiatives.",{"type":24,"tag":64,"props":80,"children":81},{},[82],{"type":30,"value":83},"Create and update landing pages.",{"type":24,"tag":64,"props":85,"children":86},{},[87],{"type":30,"value":88},"Support SEO optimization efforts.",{"type":24,"tag":64,"props":90,"children":91},{},[92],{"type":30,"value":93},"Plan, execute, and monitor A/B testing initiatives.",{"type":24,"tag":64,"props":95,"children":96},{},[97],{"type":30,"value":98},"Analyze customer behavior and ecommerce funnel performance to identify optimization opportunities.",{"type":24,"tag":64,"props":100,"children":101},{},[102],{"type":30,"value":103},"Make strategic recommendations based on data and user insights.",{"type":24,"tag":64,"props":105,"children":106},{},[107],{"type":30,"value":108},"Collaborate with cross-functional teams to continuously improve the online shopping experience.",{"type":24,"tag":33,"props":110,"children":111},{},[112],{"type":30,"value":113},"Availability: Part-time hours. Long-term engagement with the potential to scale to full-time",{"type":24,"tag":25,"props":115,"children":117},{"id":116},"whats-in-it-for-you",[118],{"type":30,"value":119},"What’s in it for you",{"type":24,"tag":121,"props":122,"children":123},"ol",{},[124,129,134,139],{"type":24,"tag":64,"props":125,"children":126},{},[127],{"type":30,"value":128},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":24,"tag":64,"props":130,"children":131},{},[132],{"type":30,"value":133},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":24,"tag":64,"props":135,"children":136},{},[137],{"type":30,"value":138},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":24,"tag":64,"props":140,"children":141},{},[142],{"type":30,"value":143},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":24,"tag":25,"props":145,"children":147},{"id":146},"required-qualifications",[148],{"type":30,"value":149},"Required Qualifications",{"type":24,"tag":60,"props":151,"children":152},{},[153,158,163,168,173,178,183,188,193],{"type":24,"tag":64,"props":154,"children":155},{},[156],{"type":30,"value":157},"Advanced to fluent speaking and writing English. Able to have a real-time conversation.",{"type":24,"tag":64,"props":159,"children":160},{},[161],{"type":30,"value":162},"3+ years managing Shopify storefronts.",{"type":24,"tag":64,"props":164,"children":165},{},[166],{"type":30,"value":167},"3+ years in ecommerce operations and merchandising.",{"type":24,"tag":64,"props":169,"children":170},{},[171],{"type":30,"value":172},"2+ years coordinating content and product launches.",{"type":24,"tag":64,"props":174,"children":175},{},[176],{"type":30,"value":177},"2+ years with A/B testing and conversion optimization.",{"type":24,"tag":64,"props":179,"children":180},{},[181],{"type":30,"value":182},"Analytical mindset with the ability to interpret customer behavior and ecommerce metrics.",{"type":24,"tag":64,"props":184,"children":185},{},[186],{"type":30,"value":187},"Strong organizational skills and attention to detail.",{"type":24,"tag":64,"props":189,"children":190},{},[191],{"type":30,"value":192},"Customer-centric approach to decision-making.",{"type":24,"tag":64,"props":194,"children":195},{},[196],{"type":30,"value":197},"Ability to prioritize multiple initiatives in a fast-paced environment.",{"type":24,"tag":25,"props":199,"children":201},{"id":200},"nice-to-haves",[202],{"type":30,"value":203},"Nice to haves",{"type":24,"tag":60,"props":205,"children":206},{},[207,212,217,222,227],{"type":24,"tag":64,"props":208,"children":209},{},[210],{"type":30,"value":211},"Experience with SEO best practices.",{"type":24,"tag":64,"props":213,"children":214},{},[215],{"type":30,"value":216},"Experience optimizing ecommerce funnels and customer journeys.",{"type":24,"tag":64,"props":218,"children":219},{},[220],{"type":30,"value":221},"Familiarity with product merchandising strategies.",{"type":24,"tag":64,"props":223,"children":224},{},[225],{"type":30,"value":226},"Experience working with Shopify apps and ecommerce optimization tools.",{"type":24,"tag":64,"props":228,"children":229},{},[230],{"type":30,"value":231},"Experience supporting high-growth ecommerce brands.",{"type":24,"tag":25,"props":233,"children":235},{"id":234},"frequently-asked-questions",[236],{"type":30,"value":237},"Frequently Asked Questions",{"type":24,"tag":239,"props":240,"children":241},"blockquote",{},[242],{"type":24,"tag":33,"props":243,"children":244},{},[245],{"type":24,"tag":246,"props":247,"children":248},"em",{},[249],{"type":30,"value":250},"What are your typical clients?",{"type":24,"tag":33,"props":252,"children":253},{},[254],{"type":30,"value":255},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":24,"tag":239,"props":257,"children":258},{},[259],{"type":24,"tag":33,"props":260,"children":261},{},[262],{"type":24,"tag":246,"props":263,"children":264},{},[265],{"type":30,"value":266},"What is the length of your engagements?",{"type":24,"tag":33,"props":268,"children":269},{},[270],{"type":30,"value":271},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":24,"tag":239,"props":273,"children":274},{},[275],{"type":24,"tag":33,"props":276,"children":277},{},[278],{"type":24,"tag":246,"props":279,"children":280},{},[281],{"type":30,"value":282},"What’s your company size?",{"type":24,"tag":33,"props":284,"children":285},{},[286],{"type":30,"value":287},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 200+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":24,"tag":239,"props":289,"children":290},{},[291],{"type":24,"tag":33,"props":292,"children":293},{},[294],{"type":24,"tag":246,"props":295,"children":296},{},[297],{"type":30,"value":298},"What happens if the engagement is completed?",{"type":24,"tag":33,"props":300,"children":301},{},[302],{"type":30,"value":303},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":24,"tag":239,"props":305,"children":306},{},[307],{"type":24,"tag":33,"props":308,"children":309},{},[310],{"type":24,"tag":246,"props":311,"children":312},{},[313],{"type":30,"value":314},"What are your core values?",{"type":24,"tag":33,"props":316,"children":317},{},[318],{"type":30,"value":319},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":24,"tag":33,"props":321,"children":322},{},[323],{"type":30,"value":324},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":24,"tag":33,"props":326,"children":327},{},[328],{"type":30,"value":329},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":7,"searchDepth":331,"depth":331,"links":332},2,[333,334,335,336,337,338],{"id":27,"depth":331,"text":31},{"id":40,"depth":331,"text":43},{"id":116,"depth":331,"text":119},{"id":146,"depth":331,"text":149},{"id":200,"depth":331,"text":203},{"id":234,"depth":331,"text":237},"markdown","content:opportunities:shopify-ecommerce-coordinator-460.md","content","opportunities/shopify-ecommerce-coordinator-460.md","md",[345,638,894],{"_path":346,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":347,"description":7,"draft":6,"tags":348,"related_content":349,"short_title":347,"header_one":350,"header_two":351,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":352,"image_url":7,"hero_image":7,"body":356,"_type":339,"_id":636,"_source":341,"_file":637,"_extension":343},"/opportunities/fullstack-shopify-458","Full Stack Developer - Shopify",[10],[],"Full Stack Developer","Shopify",[353,354,355],"account-wrench","language-javascript","cart",{"type":21,"children":357,"toc":628},[358,362,367,371,376,381,386,424,429,433,452,456,524,528,546,550,560,564,574,578,588,592,602,606,616,620,624],{"type":24,"tag":25,"props":359,"children":360},{"id":27},[361],{"type":30,"value":31},{"type":24,"tag":33,"props":363,"children":364},{},[365],{"type":30,"value":366},"We're looking for a Full Stack Developer - Shopify. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":368,"children":369},{"id":40},[370],{"type":30,"value":43},{"type":24,"tag":33,"props":372,"children":373},{},[374],{"type":30,"value":375},"Our client offers and manufactures grooming products of soap, deodorant, shampoo, and toothpaste with natural ingredients for men.",{"type":24,"tag":33,"props":377,"children":378},{},[379],{"type":30,"value":380},"Overview\nWe're looking for a Senior Full Stack Shopify Developer to help scale and optimize a Shopify storefront built on a custom Shopify Liquid theme. This will be the most senior technical resource on the team, responsible for improving existing functionality, building new features, and supporting the continued evolution of the ecommerce platform.",{"type":24,"tag":33,"props":382,"children":383},{},[384],{"type":30,"value":385},"Key Responsibilities",{"type":24,"tag":60,"props":387,"children":388},{},[389,394,399,404,409,414,419],{"type":24,"tag":64,"props":390,"children":391},{},[392],{"type":30,"value":393},"Optimize and enhance the existing Shopify storefront.",{"type":24,"tag":64,"props":395,"children":396},{},[397],{"type":30,"value":398},"Improve and maintain the custom bundle builder.",{"type":24,"tag":64,"props":400,"children":401},{},[402],{"type":30,"value":403},"Build and maintain Shopify Functions.",{"type":24,"tag":64,"props":405,"children":406},{},[407],{"type":30,"value":408},"Develop and maintain API integrations.",{"type":24,"tag":64,"props":410,"children":411},{},[412],{"type":30,"value":413},"Support A/B testing implementation and experimentation.",{"type":24,"tag":64,"props":415,"children":416},{},[417],{"type":30,"value":418},"Improve storefront performance and overall user experience.",{"type":24,"tag":64,"props":420,"children":421},{},[422],{"type":30,"value":423},"Collaborate with cross-functional stakeholders to deliver scalable ecommerce solutions.",{"type":24,"tag":33,"props":425,"children":426},{},[427],{