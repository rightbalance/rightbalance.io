[{"data":1,"prerenderedAt":719},["Reactive",2],{"opportunities-element-it-security-engineer-475":3,"opportunities":289},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"draft":6,"tags":9,"related_content":11,"short_title":8,"header_one":12,"header_two":13,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":17,"image_url":7,"hero_image":7,"body":20,"_type":284,"_id":285,"_source":286,"_file":287,"_extension":288},"/opportunities/it-security-engineer-475","opportunities",false,"","IT & Security Engineer",[10],"oportunity",[],"IT & Security","Engineer","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrWu1M0aA9QTvTVF",[18,19],"monitor-account","lock-check",{"type":21,"children":22,"toc":275},"root",[23,32,38,44,49,54,59,69,75,99,105,143,149,177,183,196,201,212,217,228,233,244,249,260,265,270],{"type":24,"tag":25,"props":26,"children":28},"element","h2",{"id":27},"overview",[29],{"type":30,"value":31},"text","Overview",{"type":24,"tag":33,"props":34,"children":35},"p",{},[36],{"type":30,"value":37},"Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":39,"children":41},{"id":40},"client-engagement-details",[42],{"type":30,"value":43},"Client Engagement Details",{"type":24,"tag":33,"props":45,"children":46},{},[47],{"type":30,"value":48},"Right Balance is taking its cybersecurity program to the next level to further protect its workforce, company information, and access to client environments.",{"type":24,"tag":33,"props":50,"children":51},{},[52],{"type":30,"value":53},"You will work directly with Right Balance’s Fractional CISO to improve and operate the company’s IT and security controls across a distributed workforce. This is a hands-on technical role focused on turning new security requirements and policies into practical, working solutions.\nYou will help deploy, configure, and administer endpoint security, device management, identity and access controls, patch management, security awareness tools, and supporting IT/security processes. The environment includes a mix of Windows, macOS, and Linux endpoints.",{"type":24,"tag":33,"props":55,"children":56},{},[57],{"type":30,"value":58},"The initial engagement will focus on implementing the next version of Right Balance’s Security Program over approximately six months, with the potential for continued ongoing IT and security support following implementation.",{"type":24,"tag":60,"props":61,"children":62},"ul",{},[63],{"type":24,"tag":64,"props":65,"children":66},"li",{},[67],{"type":30,"value":68},"Availability: Part-time, approximately 10 hours per week, with flexibility based on project needs.",{"type":24,"tag":25,"props":70,"children":72},{"id":71},"whats-in-it-for-you",[73],{"type":30,"value":74},"What’s in it for you",{"type":24,"tag":76,"props":77,"children":78},"ol",{},[79,84,89,94],{"type":24,"tag":64,"props":80,"children":81},{},[82],{"type":30,"value":83},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":24,"tag":64,"props":85,"children":86},{},[87],{"type":30,"value":88},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":24,"tag":64,"props":90,"children":91},{},[92],{"type":30,"value":93},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":24,"tag":64,"props":95,"children":96},{},[97],{"type":30,"value":98},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":24,"tag":25,"props":100,"children":102},{"id":101},"required-qualifications",[103],{"type":30,"value":104},"Required Qualifications",{"type":24,"tag":60,"props":106,"children":107},{},[108,113,118,123,128,133,138],{"type":24,"tag":64,"props":109,"children":110},{},[111],{"type":30,"value":112},"Upper-intermediate to fluent speaking and writing English. Able to have a real-time conversation.",{"type":24,"tag":64,"props":114,"children":115},{},[116],{"type":30,"value":117},"5+ years of hands-on IT systems administration, endpoint management, or cybersecurity experience.",{"type":24,"tag":64,"props":119,"children":120},{},[121],{"type":30,"value":122},"Hands-on experience managing Windows and macOS endpoints, including endpoint security/EDR, patching, device management, and troubleshooting.",{"type":24,"tag":64,"props":124,"children":125},{},[126],{"type":30,"value":127},"Experience with identity and access management (IAM), including MFA, user provisioning/deprovisioning, and access controls.",{"type":24,"tag":64,"props":129,"children":130},{},[131],{"type":30,"value":132},"Experience administering Google Workspace and supporting users in a cloud-based, remote environment.",{"type":24,"tag":64,"props":134,"children":135},{},[136],{"type":30,"value":137},"Working knowledge of endpoint security, vulnerability remediation, malware protection, and security best practices.",{"type":24,"tag":64,"props":139,"children":140},{},[141],{"type":30,"value":142},"Strong troubleshooting, documentation, and communication skills with the ability to work independently and own technical tasks through completion.",{"type":24,"tag":25,"props":144,"children":146},{"id":145},"nice-to-haves",[147],{"type":30,"value":148},"Nice to haves",{"type":24,"tag":60,"props":150,"children":151},{},[152,157,162,167,172],{"type":24,"tag":64,"props":153,"children":154},{},[155],{"type":30,"value":156},"Experience with JumpCloud or similar identity, device, and patch management platforms.",{"type":24,"tag":64,"props":158,"children":159},{},[160],{"type":30,"value":161},"Experience supporting BYOD and Linux/Ubuntu endpoints.",{"type":24,"tag":64,"props":163,"children":164},{},[165],{"type":30,"value":166},"Familiarity with security awareness/phishing platforms, vulnerability management, and security compliance or audit evidence collection.",{"type":24,"tag":64,"props":168,"children":169},{},[170],{"type":30,"value":171},"Familiarity with NIST, CIS Controls, or CIS Benchmarks.",{"type":24,"tag":64,"props":173,"children":174},{},[175],{"type":30,"value":176},"Relevant IT/security certifications and/or a Bachelor’s degree in Computer Science or equivalent demonstrated ability.",{"type":24,"tag":25,"props":178,"children":180},{"id":179},"frequently-asked-questions",[181],{"type":30,"value":182},"Frequently Asked Questions",{"type":24,"tag":184,"props":185,"children":186},"blockquote",{},[187],{"type":24,"tag":33,"props":188,"children":189},{},[190],{"type":24,"tag":191,"props":192,"children":193},"em",{},[194],{"type":30,"value":195},"What are your typical clients?",{"type":24,"tag":33,"props":197,"children":198},{},[199],{"type":30,"value":200},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":24,"tag":184,"props":202,"children":203},{},[204],{"type":24,"tag":33,"props":205,"children":206},{},[207],{"type":24,"tag":191,"props":208,"children":209},{},[210],{"type":30,"value":211},"What is the length of your engagements?",{"type":24,"tag":33,"props":213,"children":214},{},[215],{"type":30,"value":216},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":24,"tag":184,"props":218,"children":219},{},[220],{"type":24,"tag":33,"props":221,"children":222},{},[223],{"type":24,"tag":191,"props":224,"children":225},{},[226],{"type":30,"value":227},"What’s your company size?",{"type":24,"tag":33,"props":229,"children":230},{},[231],{"type":30,"value":232},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":24,"tag":184,"props":234,"children":235},{},[236],{"type":24,"tag":33,"props":237,"children":238},{},[239],{"type":24,"tag":191,"props":240,"children":241},{},[242],{"type":30,"value":243},"What happens if the engagement is completed?",{"type":24,"tag":33,"props":245,"children":246},{},[247],{"type":30,"value":248},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":24,"tag":184,"props":250,"children":251},{},[252],{"type":24,"tag":33,"props":253,"children":254},{},[255],{"type":24,"tag":191,"props":256,"children":257},{},[258],{"type":30,"value":259},"What are your core values?",{"type":24,"tag":33,"props":261,"children":262},{},[263],{"type":30,"value":264},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":24,"tag":33,"props":266,"children":267},{},[268],{"type":30,"value":269},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":24,"tag":33,"props":271,"children":272},{},[273],{"type":30,"value":274},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":7,"searchDepth":276,"depth":276,"links":277},2,[278,279,280,281,282,283],{"id":27,"depth":276,"text":31},{"id":40,"depth":276,"text":43},{"id":71,"depth":276,"text":74},{"id":101,"depth":276,"text":104},{"id":145,"depth":276,"text":148},{"id":179,"depth":276,"text":182},"markdown","content:opportunities:it-security-engineer-475.md","content","opportunities/it-security-engineer-475.md","md",[290,507],{"_path":291,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":292,"description":7,"draft":6,"tags":293,"related_content":294,"short_title":292,"header_one":295,"header_two":296,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":297,"image_url":7,"hero_image":7,"body":300,"_type":284,"_id":505,"_source":286,"_file":506,"_extension":288},"/opportunities/ai-engineer-476","AI-Native Software Engineer",[10],[],"AI-Native","Software Engineer",[298,299],"account","language-typescript",{"type":21,"children":301,"toc":497},[302,306,311,315,320,343,348,352,371,375,397,401,414,418,428,432,442,446,456,461,471,475,485,489,493],{"type":24,"tag":25,"props":303,"children":304},{"id":27},[305],{"type":30,"value":31},{"type":24,"tag":33,"props":307,"children":308},{},[309],{"type":30,"value":310},"We're looking for a AI-Native Software Engineer. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":312,"children":313},{"id":40},[314],{"type":30,"value":43},{"type":24,"tag":33,"props":316,"children":317},{},[318],{"type":30,"value":319},"Our client operates in the healthcare space, pairing patients with dedicated Advocates to navigate mental health care alongside PCPs. They handle regulated data, so compliance and high quality are key.\nWe are seeking a strong technical leader to drive their engineering efforts. This role is ideal for a hands-on Mid-to-Senior Software Engineer.",{"type":24,"tag":60,"props":321,"children":322},{},[323,328,333,338],{"type":24,"tag":64,"props":324,"children":325},{},[326],{"type":30,"value":327},"Develop, maintain, and optimize user-facing features and backend services using modern Web technologies.",{"type":24,"tag":64,"props":329,"children":330},{},[331],{"type":30,"value":332},"Leverage AI-native workflows day to day, utilizing coding agents and building/managing agentic harnesses (automated review, testing, and evaluation loops).",{"type":24,"tag":64,"props":334,"children":335},{},[336],{"type":30,"value":337},"Integrate systems securely while adhering to HIPAA guidelines and handling sensitive healthcare/regulated data.",{"type":24,"tag":64,"props":339,"children":340},{},[341],{"type":30,"value":342},"Collaborate asynchronously and synchronously with US-based engineering teams during US Eastern business hours.",{"type":24,"tag":33,"props":344,"children":345},{},[346],{"type":30,"value":347},"Availability: Part-time (20 hours per week).",{"type":24,"tag":25,"props":349,"children":350},{"id":71},[351],{"type":30,"value":74},{"type":24,"tag":76,"props":353,"children":354},{},[355,359,363,367],{"type":24,"tag":64,"props":356,"children":357},{},[358],{"type":30,"value":83},{"type":24,"tag":64,"props":360,"children":361},{},[362],{"type":30,"value":88},{"type":24,"tag":64,"props":364,"children":365},{},[366],{"type":30,"value":93},{"type":24,"tag":64,"props":368,"children":369},{},[370],{"type":30,"value":98},{"type":24,"tag":25,"props":372,"children":373},{"id":101},[374],{"type":30,"value":104},{"type":24,"tag":60,"props":376,"children":377},{},[378,382,387,392],{"type":24,"tag":64,"props":379,"children":380},{},[381],{"type":30,"value":112},{"type":24,"tag":64,"props":383,"children":384},{},[385],{"type":30,"value":386},"3+ years AI-Native Workflow: Daily experience working with AI coding agents and familiarity with agentic harnesses (eval loops, automated test/review).",{"type":24,"tag":64,"props":388,"children":389},{},[390],{"type":30,"value":391},"3+ years Tech Stack: Strong hands-on proficiency with TypeScript and React.",{"type":24,"tag":64,"props":393,"children":394},{},[395],{"type":30,"value":396},"Compliance & Security: Willingness and ability to complete HIPAA training, sign NDAs, and sign IP assignments.",{"type":24,"tag":25,"props":398,"children":399},{"id":145},[400],{"type":30,"value":148},{"type":24,"tag":60,"props":402,"children":403},{},[404,409],{"type":24,"tag":64,"props":405,"children":406},{},[407],{"type":30,"value":408},"1+ years Direct experience working in Healthcare or handling regulated data/PHI.",{"type":24,"tag":64,"props":410,"children":411},{},[412],{"type":30,"value":413},"1+ years Cloud infrastructure experience with Google Cloud Platform (GCP).",{"type":24,"tag":25,"props":415,"children":416},{"id":179},[417],{"type":30,"value":182},{"type":24,"tag":184,"props":419,"children":420},{},[421],{"type":24,"tag":33,"props":422,"children":423},{},[424],{"type":24,"tag":191,"props":425,"children":426},{},[427],{"type":30,"value":195},{"type":24,"tag":33,"props":429,"children":430},{},[431],{"type":30,"value":200},{"type":24,"tag":184,"props":433,"children":434},{},[435],{"type":24,"tag":33,"props":436,"children":437},{},[438],{"type":24,"tag":191,"props":439,"children":440},{},[441],{"type":30,"value":211},{"type":24,"tag":33,"props":443,"children":444},{},[445],{"type":30,"value":216},{"type":24,"tag":184,"props":447,"children":448},{},[449],{"type":24,"tag":33,"props":450,"children":451},{},[452],{"type":24,"tag":191,"props":453,"children":454},{},[455],{"type":30,"value":227},{"type":24,"tag":33,"props":457,"children":458},{},[459],{"type":30,"value":460},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 50+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":24,"tag":184,"props":462,"children":463},{},[464],{"type":24,"tag":33,"props":465,"children":466},{},[467],{"type":24,"tag":191,"props":468,"children":469},{},[470],{"type":30,"value":243},{"type":24,"tag":33,"props":472,"children":473},{},[474],{"type":30,"value":248},{"type":24,"tag":184,"props":476,"children":477},{},[478],{"type":24,"tag":33,"props":479,"children":480},{},[481],{"type":24,"tag":191,"props":482,"children":483},{},[484],{"type":30,"value":259},{"type"