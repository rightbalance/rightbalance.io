,{"type":30,"value":228},{"type":24,"tag":164,"props":674,"children":675},{},[676],{"type":24,"tag":33,"props":677,"children":678},{},[679],{"type":24,"tag":171,"props":680,"children":681},{},[682],{"type":30,"value":239},{"type":24,"tag":33,"props":684,"children":685},{},[686],{"type":30,"value":244},{"type":24,"tag":33,"props":688,"children":689},{},[690],{"type":30,"value":249},{"type":24,"tag":33,"props":692,"children":693},{},[694],{"type":30,"value":254},{"title":7,"searchDepth":256,"depth":256,"links":696},[697,698,699,700,701,702],{"id":27,"depth":256,"text":31},{"id":40,"depth":256,"text":43},{"id":81,"depth":256,"text":84},{"id":111,"depth":256,"text":114},{"id":140,"depth":256,"text":143},{"id":159,"depth":256,"text":162},{"_path":704,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":705,"description":7,"draft":6,"tags":706,"related_content":707,"short_title":705,"header_one":708,"header_two":709,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":710,"image_url":7,"hero_image":7,"body":713,"_type":264,"_id":938,"_source":266,"_file":939,"_extension":268},"/opportunities/it-security-engineer-475","IT & Security Engineer",[10],[],"IT & Security","Engineer",[711,712],"monitor-account","lock-check",{"type":21,"children":714,"toc":930},[715,719,724,728,733,738,743,751,755,774,778,815,819,847,851,861,865,875,879,889,894,904,908,918,922,926],{"type":24,"tag":25,"props":716,"children":717},{"id":27},[718],{"type":30,"value":31},{"type":24,"tag":33,"props":720,"children":721},{},[722],{"type":30,"value":723},"Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":725,"children":726},{"id":40},[727],{"type":30,"value":43},{"type":24,"tag":33,"props":729,"children":730},{},[731],{"type":30,"value":732},"Right Balance is taking its cybersecurity program to the next level to further protect its workforce, company information, and access to client environments.",{"type":24,"tag":33,"props":734,"children":735},{},[736],{"type":30,"value":737},"You will work directly with Right Balance’s Fractional CISO to improve and operate the company’s IT and security controls across a distributed workforce. This is a hands-on technical role focused on turning new security requirements and policies into practical, working solutions.\nYou will help deploy, configure, and administer endpoint security, device management, identity and access controls, patch management, security awareness tools, and supporting IT/security processes. The environment includes a mix of Windows, macOS, and Linux endpoints.",{"type":24,"tag":33,"props":739,"children":740},{},[741],{"type":30,"value":742},"The initial engagement will focus on implementing the next version of Right Balance’s Security Program over approximately six months, with the potential for continued ongoing IT and security support following implementation.",{"type":24,"tag":50,"props":744,"children":745},{},[746],{"type":24,"tag":54,"props":747,"children":748},{},[749],{"type":30,"value":750},"Availability: Part-time, approximately 10 hours per week, with flexibility based on project needs.",{"type":24,"tag":25,"props":752,"children":753},{"id":81},[754],{"type":30,"value":84},{"type":24,"tag":86,"props":756,"children":757},{},[758,762,766,770],{"type":24,"tag":54,"props":759,"children":760},{},[761],{"type":30,"value":93},{"type":24,"tag":54,"props":763,"children":764},{},[765],{"type":30,"value":98},{"type":24,"tag":54,"props":767,"children":768},{},[769],{"type":30,"value":103},{"type":24,"tag":54,"props":771,"children":772},{},[773],{"type":30,"value":108},{"type":24,"tag":25,"props":775,"children":776},{"id":111},[777],{"type":30,"value":114},{"type":24,"tag":50,"props":779,"children":780},{},[781,785,790,795,800,805,810],{"type":24,"tag":54,"props":782,"children":783},{},[784],{"type":30,"value":122},{"type":24,"tag":54,"props":786,"children":787},{},[788],{"type":30,"value":789},"5+ years of hands-on IT systems administration, endpoint management, or cybersecurity experience.",{"type":24,"tag":54,"props":791,"children":792},{},[793],{"type":30,"value":794},"Hands-on experience managing Windows and macOS endpoints, including endpoint security/EDR, patching, device management, and troubleshooting.",{"type":24,"tag":54,"props":796,"children":797},{},[798],{"type":30,"value":799},"Experience with identity and access management (IAM), including MFA, user provisioning/deprovisioning, and access controls.",{"type":24,"tag":54,"props":801,"children":802},{},[803],{"type":30,"value":804},"Experience administering Google Workspace and supporting users in a cloud-based, remote environment.",{"type":24,"tag":54,"props":806,"children":807},{},[808],{"type":30,"value":809},"Working knowledge of endpoint security, vulnerability remediation, malware protection, and security best practices.",{"type":24,"tag":54,"props":811,"children":812},{},[813],{"type":30,"value":814},"Strong troubleshooting, documentation, and communication skills with the ability to work independently and own technical tasks through completion.",{"type":24,"tag":25,"props":816,"children":817},{"id":140},[818],{"type":30,"value":143},{"type":24,"tag":50,"props":820,"children":821},{},[822,827,832,837,842],{"type":24,"tag":54,"props":823,"children":824},{},[825],{"type":30,"value":826},"Experience with JumpCloud or similar identity, device, and patch management platforms.",{"type":24,"tag":54,"props":828,"children":829},{},[830],{"type":30,"value":831},"Experience supporting BYOD and Linux/Ubuntu endpoints.",{"type":24,"tag":54,"props":833,"children":834},{},[835],{"type":30,"value":836},"Familiarity with security awareness/phishing platforms, vulnerability management, and security compliance or audit evidence collection.",{"type":24,"tag":54,"props":838,"children":839},{},[840],{"type":30,"value":841},"Familiarity with NIST, CIS Controls, or CIS Benchmarks.",{"type":24,"tag":54,"props":843,"children":844},{},[845],{"type":30,"value":846},"Relevant IT/security certifications and/or a Bachelor’s degree in Computer Science or equivalent demonstrated ability.",{"type":24,"tag":25,"props":848,"children":849},{"id":159},[850],{"type":30,"value":162},{"type":24,"tag":164,"props":852,"children":853},{},[854],{"type":24,"tag":33,"props":855,"children":856},{},[857],{"type":24,"tag":171,"props":858,"children":859},{},[860],{"type":30,"value":175},{"type":24,"tag":33,"props":862,"children":863},{},[864],{"type":30,"value":180},{"type":24,"tag":164,"props":866,"children":867},{},[868],{"type":24,"tag":33,"props":869,"children":870},{},[871],{"type":24,"tag":171,"props":872,"children":873},{},[874],{"type":30,"value":191},{"type":24,"tag":33,"props":876,"children":877},{},[878],{"type":30,"value":196},{"type":24,"tag":164,"props":880,"children":881},{},[882],{"type":24,"tag":33,"props":883,"children":884},{},[885],{"type":24,"tag":171,"props":886,"children":887},{},[888],{"type":30,"value":207},{"type":24,"tag":33,"props":890,"children":891},{},[892],{"type":30,"value":893},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":24,"tag":164,"props":895,"children":896},{},[897],{"type":24,"tag":33,"props":898,"children":899},{},[900],{"type":24,"tag":171,"props":901,"children":902},{},[903],{"type":30,"value":223},{"type":24,"tag":33,"props":905,"children":906},{},[907],{"type":30,"value":228},{"type":24,"tag":164,"props":909,"children":910},{},[911],{"type":24,"tag":33,"props":912,"children":913},{},[914],{"type":24,"tag":171,"props":915,"children":916},{},[917],{"type":30,"value":239},{"type":24,"tag":33,"props":919,"children":920},{},[921],{"type":30,"value":244},{"type":24,"tag":33,"props":923,"children":924},{},[925],{"type":30,"value":249},{"type":24,"tag":33,"props":927,