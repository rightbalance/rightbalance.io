[{"data":1,"prerenderedAt":940},["Reactive",2],{"opportunities-element-ai-engineer-476":3,"opportunities":269},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"draft":6,"tags":9,"related_content":11,"short_title":8,"header_one":12,"header_two":13,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":17,"image_url":7,"hero_image":7,"body":20,"_type":264,"_id":265,"_source":266,"_file":267,"_extension":268},"/opportunities/ai-engineer-476","opportunities",false,"","AI-Native Software Engineer",[10],"oportunity",[],"AI-Native","Software Engineer","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrWu1M0aA9QTvTVF",[18,19],"account","language-typescript",{"type":21,"children":22,"toc":255},"root",[23,32,38,44,49,74,79,85,109,115,138,144,157,163,176,181,192,197,208,213,224,229,240,245,250],{"type":24,"tag":25,"props":26,"children":28},"element","h2",{"id":27},"overview",[29],{"type":30,"value":31},"text","Overview",{"type":24,"tag":33,"props":34,"children":35},"p",{},[36],{"type":30,"value":37},"We're looking for a AI-Native Software Engineer. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":39,"children":41},{"id":40},"client-engagement-details",[42],{"type":30,"value":43},"Client Engagement Details",{"type":24,"tag":33,"props":45,"children":46},{},[47],{"type":30,"value":48},"Our client operates in the healthcare space, pairing patients with dedicated Advocates to navigate mental health care alongside PCPs. They handle regulated data, so compliance and high quality are key.\nWe are seeking a strong technical leader to drive their engineering efforts. This role is ideal for a hands-on Mid-to-Senior Software Engineer.",{"type":24,"tag":50,"props":51,"children":52},"ul",{},[53,59,64,69],{"type":24,"tag":54,"props":55,"children":56},"li",{},[57],{"type":30,"value":58},"Develop, maintain, and optimize user-facing features and backend services using modern Web technologies.",{"type":24,"tag":54,"props":60,"children":61},{},[62],{"type":30,"value":63},"Leverage AI-native workflows day to day, utilizing coding agents and building/managing agentic harnesses (automated review, testing, and evaluation loops).",{"type":24,"tag":54,"props":65,"children":66},{},[67],{"type":30,"value":68},"Integrate systems securely while adhering to HIPAA guidelines and handling sensitive healthcare/regulated data.",{"type":24,"tag":54,"props":70,"children":71},{},[72],{"type":30,"value":73},"Collaborate asynchronously and synchronously with US-based engineering teams during US Eastern business hours.",{"type":24,"tag":33,"props":75,"children":76},{},[77],{"type":30,"value":78},"Availability: Part-time (20 hours per week).",{"type":24,"tag":25,"props":80,"children":82},{"id":81},"whats-in-it-for-you",[83],{"type":30,"value":84},"What’s in it for you",{"type":24,"tag":86,"props":87,"children":88},"ol",{},[89,94,99,104],{"type":24,"tag":54,"props":90,"children":91},{},[92],{"type":30,"value":93},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":24,"tag":54,"props":95,"children":96},{},[97],{"type":30,"value":98},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":24,"tag":54,"props":100,"children":101},{},[102],{"type":30,"value":103},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":24,"tag":54,"props":105,"children":106},{},[107],{"type":30,"value":108},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":24,"tag":25,"props":110,"children":112},{"id":111},"required-qualifications",[113],{"type":30,"value":114},"Required Qualifications",{"type":24,"tag":50,"props":116,"children":117},{},[118,123,128,133],{"type":24,"tag":54,"props":119,"children":120},{},[121],{"type":30,"value":122},"Upper-intermediate to fluent speaking and writing English. Able to have a real-time conversation.",{"type":24,"tag":54,"props":124,"children":125},{},[126],{"type":30,"value":127},"3+ years AI-Native Workflow: Daily experience working with AI coding agents and familiarity with agentic harnesses (eval loops, automated test/review).",{"type":24,"tag":54,"props":129,"children":130},{},[131],{"type":30,"value":132},"3+ years Tech Stack: Strong hands-on proficiency with TypeScript and React.",{"type":24,"tag":54,"props":134,"children":135},{},[136],{"type":30,"value":137},"Compliance & Security: Willingness and ability to complete HIPAA training, sign NDAs, and sign IP assignments.",{"type":24,"tag":25,"props":139,"children":141},{"id":140},"nice-to-haves",[142],{"type":30,"value":143},"Nice to haves",{"type":24,"tag":50,"props":145,"children":146},{},[147,152],{"type":24,"tag":54,"props":148,"children":149},{},[150],{"type":30,"value":151},"1+ years Direct experience working in Healthcare or handling regulated data/PHI.",{"type":24,"tag":54,"props":153,"children":154},{},[155],{"type":30,"value":156},"1+ years Cloud infrastructure experience with Google Cloud Platform (GCP).",{"type":24,"tag":25,"props":158,"children":160},{"id":159},"frequently-asked-questions",[161],{"type":30,"value":162},"Frequently Asked Questions",{"type":24,"tag":164,"props":165,"children":166},"blockquote",{},[167],{"type":24,"tag":33,"props":168,"children":169},{},[170],{"type":24,"tag":171,"props":172,"children":173},"em",{},[174],{"type":30,"value":175},"What are your typical clients?",{"type":24,"tag":33,"props":177,"children":178},{},[179],{"type":30,"value":180},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":24,"tag":164,"props":182,"children":183},{},[184],{"type":24,"tag":33,"props":185,"children":186},{},[187],{"type":24,"tag":171,"props":188,"children":189},{},[190],{"type":30,"value":191},"What is the length of your engagements?",{"type":24,"tag":33,"props":193,"children":194},{},[195],{"type":30,"value":196},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":24,"tag":164,"props":198,"children":199},{},[200],{"type":24,"tag":33,"props":201,"children":202},{},[203],{"type":24,"tag":171,"props":204,"children":205},{},[206],{"type":30,"value":207},"What’s your company size?",{"type":24,"tag":33,"props":209,"children":210},{},[211],{"type":30,"value":212},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 50+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":24,"tag":164,"props":214,"children":215},{},[216],{"type":24,"tag":33,"props":217,"children":218},{},[219],{"type":24,"tag":171,"props":220,"children":221},{},[222],{"type":30,"value":223},"What happens if the engagement is completed?",{"type":24,"tag":33,"props":225,"children":226},{},[227],{"type":30,"value":228},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":24,"tag":164,"props":230,"children":231},{},[232],{"type":24,"tag":33,"props":233,"children":234},{},[235],{"type":24,"tag":171,"props":236,"children":237},{},[238],{"type":30,"value":239},"What are your core values?",{"type":24,"tag":33,"props":241,"children":242},{},[243],{"type":30,"value":244},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":24,"tag":33,"props":246,"children":247},{},[248],{"type":30,"value":249},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":24,"tag":33,"props":251,"children":252},{},[253],{"type":30,"value":254},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":7,"searchDepth":256,"depth":256,"links":257},2,[258,259,260,261,262,263],{"id":27,"depth":256,"text":31},{"id":40,"depth":256,"text":43},{"id":81,"depth":256,"text":84},{"id":111,"depth":256,"text":114},{"id":140,"depth":256,"text":143},{"id":159,"depth":256,"text":162},"markdown","content:opportunities:ai-engineer-476.md","content","opportunities/ai-engineer-476.md","md",[270,507,703],{"_path":271,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":272,"description":7,"draft":6,"tags":273,"related_content":274,"short_title":272,"header_one":272,"header_two":7,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":275,"image_url":7,"hero_image":7,"body":278,"_type":264,"_id":505,"_source":266,"_file":506,"_extension":268},"/opportunities/account-manager-419","Account Manager",[10],[],[276,277],"laptop-account","account-box",{"type":21,"children":279,"toc":498},[280,284,289,293,321,325,378,382,415,419,429,433,443,447,457,462,472,476,486,490,494],{"type":24,"tag":25,"props":281,"children":282},{"id":27},[283],{"type":30,"value":31},{"type":24,"tag":33,"props":285,"children":286},{},[287],{"type":30,"value":288},"Headquartered in Los Angeles, California, Right Balance applies the latest technology and best engineering practices to help businesses grow. We’re in the top 50 companies to watch in LA.\nRole Overview\nWe’re looking for a strong senior-level account manager to join our team. Account management is a key role in our software development organization. You’ll be working directly with executive entrepreneurs and technologists to facilitate innovation and smooth operations for US-based startups. You’ll be managing Right Balance accounts which include regular one on ones with the client, managing the sales and hiring pipeline, working directly with Right Balance HR on addressing developer and client feedback. You’ll be coming at an amazing time to manage and continue growing a team of bright and talented people.",{"type":24,"tag":25,"props":290,"children":291},{"id":81},[292],{"type":30,"value":84},{"type":24,"tag":86,"props":294,"children":295},{},[296,301,306,311,316],{"type":24,"tag":54,"props":297,"children":298},{},[299],{"type":30,"value":300},"Work with open-minded startup professionals on new and exciting ideas.",{"type":24,"tag":54,"props":302,"children":303},{},[304],{"type":30,"value":305},"Career growth opportunities in a rapidly growing company.",{"type":24,"tag":54,"props":307,"children":308},{},[309],{"type":30,"value":310},"Opportunity to further evolve the account management process for the entire company.",{"type":24,"tag":54,"props":312,"children":313},{},[314],{"type":30,"value":315},"Work remotely in the comfort of your home or a shared co-working space.",{"type":24,"tag":54,"props":317,"children":318},{},[319],{"type":30,"value":320},"Being able to help real companies make a positive impact globally.",{"type":24,"tag":25,"props":322,"children":323},{"id":111},[324],{"type":30,"value":114},{"type":24,"tag":50,"props":326,"children":327},{},[328,333,338,343,348,353,358,363,368,373],{"type":24,"tag":54,"props":329,"children":330},{},[331],{"type":30,"value":332},"5+ years of full-time Sales experience.",{"type":24,"tag":54,"props":334,"children":335},{},[336],{"type":30,"value":337},"3+ years of full-time Account Management experience.",{"type":24,"tag":54,"props":339,"children":340},{},[341],{"type":30,"value":342},"2+ years of Agency experience (Staff Augmentation / Staffing).",{"type":24,"tag":54,"props":344,"children":345},{},[346],{"type":30,"value":347},"Advanced written and verbal level of English.",{"type":24,"tag":54,"props":349,"children":350},{},[351],{"type":30,"value":352},"Ability to work in the US time zone.",{"type":24,"tag":54,"props":354,"children":355},{},[356],{"type":30,"value":357},"Detail-oriented person. Being able to relentlessly make things happen on a set schedule.",{"type":24,"tag":54,"props":359,"children":360},{},[361],{"type":30,"value":362},"Expert negotiation and problem-solving skills.",{"type":24,"tag":54,"props":364,"children":365},{},[366],{"type":30,"value":367},"Ability to empathize with the client by putting themselves in their shoes.",{"type":24,"tag":54,"props":369,"children":370},{},[371],{"type":30,"value":372},"Team management experience including hiring, coaching, effective delegation, and ownership empowerment.",{"type":24,"tag":54,"props":374,"children":375},{},[376],{"type":30,"value":377},"Expert-level ability to create and systematize robust and repeatable business processes.",{"type":24,"tag":25,"props":379,"children":380},{"id":140},[381],{"type":30,"value":143},{"type":24,"tag":50,"props":383,"children":384},{},[385,390,395,400,405,410],{"type":24,"tag":54,"props":386,"children":387},{},[388],{"type":30,"value":389},"Experience working in a software development firm.",{"type":24,"tag":54,"props":391,"children":392},{},[393],{"type":30,"value":394},"Experience managing US-based startup accounts.",{"type":24,"tag":54,"props":396,"children":397},{},[398],{"type":30,"value":399},"Growth stage startup experience.",{"type":24,"tag":54,"props":401,"children":402},{},[403],{"type":30,"value":404},"Deep understanding of software development cycle and Agile / Scrum methodologies.",{"type":24,"tag":54,"props":406,"children":407},{},[408],{"type":30,"value":409},"Industry publications and/or presentations.",{"type":24,"tag":54,"props":411,"children":412},{},[413],{"type":30,"value":414},"Bac