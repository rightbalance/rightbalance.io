of full-time hands-on FHIR/OMOP experience.",{"type":24,"tag":59,"props":947,"children":948},{},[949],{"type":30,"value":950},"Background with EHR data and using it for secondary purposes, specifically experience with mapping data into OMOP or using Smart on FHIR apps.",{"type":24,"tag":59,"props":952,"children":953},{},[954],{"type":30,"value":955},"Experience working with real world data from various sources (e.g., curation workflows, EHRs, lab systems, claims, research datasets).",{"type":24,"tag":59,"props":957,"children":958},{},[959],{"type":30,"value":960},"Experience working with modern ELT tools such as DBT to maintain high volume, high velocity data warehouses",{"type":24,"tag":59,"props":962,"children":963},{},[964],{"type":30,"value":965},"Experience working with standard medical terminologies (e.g., SNOMED CT, RxNorm, LOINC, ICD-9/10).",{"type":24,"tag":25,"props":967,"children":968},{"id":165},[969],{"type":30,"value":168},{"type":24,"tag":55,"props":971,"children":972},{},[973,978,983,988,993],{"type":24,"tag":59,"props":974,"children":975},{},[976],{"type":30,"value":977},"Clinical background (MD/DO, PharmD, PA, NP, RN, etc.).",{"type":24,"tag":59,"props":979,"children":980},{},[981],{"type":30,"value":982},"Familiarity with next-generation sequencing data.",{"type":24,"tag":59,"props":984,"children":985},{},[986],{"type":30,"value":987},"Experience with real world data analysis in Python or R.",{"type":24,"tag":59,"props":989,"children":990},{},[991],{"type":30,"value":992},"Participation in professional organizations (e.g., OHDSI, AMIA).",{"type":24,"tag":59,"props":994,"children":995},{},[996],{"type":30,"value":418},{"type":24,"tag":25,"props":998,"children":999},{"id":189},[1000],{"type":30,"value":192},{"type":24,"tag":194,"props":1002,"children":1003},{},[1004],{"type":24,"tag":33,"props":1005,"children":1006},{},[1007],{"type":24,"tag":201,"props":1008,"children":1009},{},[1010],{"type":30,"value":205},{"type":24,"tag":33,"props":1012,"childr