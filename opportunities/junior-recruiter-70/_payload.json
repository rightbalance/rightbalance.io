[{"data":1,"prerenderedAt":1254},["Reactive",2],{"opportunities-element-junior-recruiter-70":3,"opportunities":262},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"draft":6,"tags":9,"related_content":11,"short_title":8,"header_one":12,"header_two":13,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":17,"image_url":7,"hero_image":7,"body":20,"_type":257,"_id":258,"_source":259,"_file":260,"_extension":261},"/opportunities/junior-recruiter-70","opportunities",false,"","Junior Technical Recruiter",[10],"oportunity",[],"Junior Technical","Recruiter","Interested in this opportunity?","Apply","https://airtable.com/app5LgbbOdsy1PtwG/shrn4RALUBunWkfJd",[18,19],"account-circle","animation-outline",{"type":21,"children":22,"toc":247},"root",[23,32,38,44,49,55,85,90,103,109,133,139,162,168,181,187,200,205,216,221,232,237,242],{"type":24,"tag":25,"props":26,"children":28},"element","h2",{"id":27},"overview",[29],{"type":30,"value":31},"text","Overview",{"type":24,"tag":33,"props":34,"children":35},"p",{},[36],{"type":30,"value":37},"Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":39,"children":41},{"id":40},"engagement-details",[42],{"type":30,"value":43},"Engagement Details",{"type":24,"tag":33,"props":45,"children":46},{},[47],{"type":30,"value":48},"We are seeking a Junior Technical Recruiter to join our team. As an Junior Recruiter, you will have the opportunity to gain valuable professional experience while working closely with our management team. You will work as a part of our Hiring team to source and engage talent, as well as introduce the best and brightest to our clients.",{"type":24,"tag":25,"props":50,"children":52},{"id":51},"what-will-you-do",[53],{"type":30,"value":54},"What will you do?",{"type":24,"tag":56,"props":57,"children":58},"ul",{},[59,65,70,75,80],{"type":24,"tag":60,"props":61,"children":62},"li",{},[63],{"type":30,"value":64},"The majority of your time will be dedicated to searching for and attracting top talent. In this role, you’ll be on a mission to find and hire brilliant software developers for our clients, helping us evolve humanity through technology.",{"type":24,"tag":60,"props":66,"children":67},{},[68],{"type":30,"value":69},"Source candidates through LinkedIn, job boards, and other creative channels.",{"type":24,"tag":60,"props":71,"children":72},{},[73],{"type":30,"value":74},"Screen profiles to assess technical skills, experience, and cultural fit.",{"type":24,"tag":60,"props":76,"children":77},{},[78],{"type":30,"value":79},"Introduce the best and brightest candidates to our clients",{"type":24,"tag":60,"props":81,"children":82},{},[83],{"type":30,"value":84},"Move the candidates through the client process and finalize the client engagement for selected candidates.",{"type":24,"tag":33,"props":86,"children":87},{},[88],{"type":30,"value":89},"Availability:",{"type":24,"tag":56,"props":91,"children":92},{},[93,98],{"type":24,"tag":60,"props":94,"children":95},{},[96],{"type":30,"value":97},"It's a full-time position: 40 hours / week",{"type":24,"tag":60,"props":99,"children":100},{},[101],{"type":30,"value":102},"Our Core Hours are 9am to 3pm Pacific Time. Regardless of your location, you'll have to be fully available during this time for video calls, all communication, and performance.",{"type":24,"tag":25,"props":104,"children":106},{"id":105},"whats-in-it-for-you",[107],{"type":30,"value":108},"What’s in it for you",{"type":24,"tag":110,"props":111,"children":112},"ol",{},[113,118,123,128],{"type":24,"tag":60,"props":114,"children":115},{},[116],{"type":30,"value":117},"Gain real-world experience in an international company, working on projects that directly impact our clients' success.",{"type":24,"tag":60,"props":119,"children":120},{},[121],{"type":30,"value":122},"Enhance your career profile with hands-on experience in talent acquisition and recruitment.",{"type":24,"tag":60,"props":124,"children":125},{},[126],{"type":30,"value":127},"Flexible remote work arrangements, allowing you to work comfortably from home.",{"type":24,"tag":60,"props":129,"children":130},{},[131],{"type":30,"value":132},"Opportunity to improve your English language skills in a professional setting.",{"type":24,"tag":25,"props":134,"children":136},{"id":135},"required-qualifications",[137],{"type":30,"value":138},"Required Qualifications",{"type":24,"tag":56,"props":140,"children":141},{},[142,147,152,157],{"type":24,"tag":60,"props":143,"children":144},{},[145],{"type":30,"value":146},"Upper Intermediate to Advanced spoken and written English, able to have a real-time conversation in English.",{"type":24,"tag":60,"props":148,"children":149},{},[150],{"type":30,"value":151},"Ability to work in the US time zone.",{"type":24,"tag":60,"props":153,"children":154},{},[155],{"type":30,"value":156},"Strong organizational skills and attention to detail.",{"type":24,"tag":60,"props":158,"children":159},{},[160],{"type":30,"value":161},"Excellent communication skills, both interpersonal and written.",{"type":24,"tag":25,"props":163,"children":165},{"id":164},"nice-to-haves",[166],{"type":30,"value":167},"Nice to haves",{"type":24,"tag":56,"props":169,"children":170},{},[171,176],{"type":24,"tag":60,"props":172,"children":173},{},[174],{"type":30,"value":175},"Experience working with startups, particularly in the growth stage.",{"type":24,"tag":60,"props":177,"children":178},{},[179],{"type":30,"value":180},"HR/TA experience",{"type":24,"tag":25,"props":182,"children":184},{"id":183},"frequently-asked-questions",[185],{"type":30,"value":186},"Frequently Asked Questions",{"type":24,"tag":188,"props":189,"children":190},"blockquote",{},[191],{"type":24,"tag":33,"props":192,"children":193},{},[194],{"type":24,"tag":195,"props":196,"children":197},"em",{},[198],{"type":30,"value":199},"What are your typical clients?",{"type":24,"tag":33,"props":201,"children":202},{},[203],{"type":30,"value":204},"The majority of our clients are venture-backed startups in the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, and the latest technologies to help companies scale.",{"type":24,"tag":188,"props":206,"children":207},{},[208],{"type":24,"tag":33,"props":209,"children":210},{},[211],{"type":24,"tag":195,"props":212,"children":213},{},[214],{"type":30,"value":215},"What’s your company size?",{"type":24,"tag":33,"props":217,"children":218},{},[219],{"type":30,"value":220},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. We’re growing quickly, be a part of it!",{"type":24,"tag":188,"props":222,"children":223},{},[224],{"type":24,"tag":33,"props":225,"children":226},{},[227],{"type":24,"tag":195,"props":228,"children":229},{},[230],{"type":30,"value":231},"What are your core values?",{"type":24,"tag":33,"props":233,"children":234},{},[235],{"type":30,"value":236},"Client First: we only win when our clients win. We treat client challenges as our own.",{"type":24,"tag":33,"props":238,"children":239},{},[240],{"type":30,"value":241},"Ownership: we embrace responsibility, taking on challenges, getting them to completion, and enjoying getting things done.",{"type":24,"tag":33,"props":243,"children":244},{},[245],{"type":30,"value":246},"Quality: we’re passionate about achieving quality outcomes by applying meticulous attention to detail.",{"title":7,"searchDepth":248,"depth":248,"links":249},2,[250,251,252,253,254,255,256],{"id":27,"depth":248,"text":31},{"id":40,"depth":248,"text":43},{"id":51,"depth":248,"text":54},{"id":105,"depth":248,"text":108},{"id":135,"depth":248,"text":138},{"id":164,"depth":248,"text":167},{"id":183,"depth":248,"text":186},"markdown","content:opportunities:junior-recruiter-70.md","content","opportunities/junior-recruiter-70.md","md",[263,567,854,1066],{"_path":264,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":265,"description":7,"draft":6,"tags":266,"related_content":267,"short_title":265,"header_one":268,"header_two":269,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":270,"image_url":7,"hero_image":7,"body":273,"_type":257,"_id":565,"_source":259,"_file":566,"_extension":261},"/opportunities/clinical-terminologist-436","Clinical Terminologist",[10],[],"Clinical","Terminologist",[271,272],"book-open-outline","hospital-box-outline",{"type":21,"children":274,"toc":557},[275,279,284,290,295,300,305,310,343,348,352,375,379,437,441,469,473,483,488,499,504,514,519,530,535,545,549,553],{"type":24,"tag":25,"props":276,"children":277},{"id":27},[278],{"type":30,"value":31},{"type":24,"tag":33,"props":280,"children":281},{},[282],{"type":30,"value":283},"We're looking for a Clinical Terminologist. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":285,"children":287},{"id":286},"client-engagement-details",[288],{"type":30,"value":289},"Client Engagement Details",{"type":24,"tag":33,"props":291,"children":292},{},[293],{"type":30,"value":294},"Our client is disrupting the clinical trial enrollment process by transforming the way researchers identify eligible patients. Using artificial intelligence and natural language processing to mine structured and unstructured patient data, we find more, better-matching patients for trials in minutes, not months.",{"type":24,"tag":33,"props":296,"children":297},{},[298],{"type":30,"value":299},"We work with some of the most prominent health systems, pharma companies, and CROs in the world, making our platform a crucial step in their clinical research workflow and greatly accelerating patients’ access to clinical trials.",{"type":24,"tag":33,"props":301,"children":302},{},[303],{"type":30,"value":304},"Join the mission to bring life-saving treatments to patients faster with AI in clinical trials.",{"type":24,"tag":33,"props":306,"children":307},{},[308],{"type":30,"value":309},"Responsibilities:",{"type":24,"tag":56,"props":311,"children":312},{},[313,318,323,328,333,338],{"type":24,"tag":60,"props":314,"children":315},{},[316],{"type":30,"value":317},"Collaborate with cross-functional teams to manage and update terminology services made available across the company.",{"type":24,"tag":60,"props":319,"children":320},{},[321],{"type":30,"value":322},"Maintain and extend modeled ontology solutions used throughout the company.",{"type":24,"tag":60,"props":324,"children":325},{},[326],{"type":30,"value":327},"Standardize clinical concepts from a variety of sources, including our client curated data, EHR integrations, and lab systems.",{"type":24,"tag":60,"props":329,"children":330},{},[331],{"type":30,"value":332},"Manage the adjudication of, and quality control pipelines for, new clinical concepts and domains.",{"type":24,"tag":60,"props":334,"children":335},{},[336],{"type":30,"value":337},"Proactively monitor and support quality assurance and process improvement initiatives.",{"type":24,"tag":60,"props":339,"children":340},{},[341],{"type":30,"value":342},"Monitor performance of production processes and recommend areas for improvement.",{"type":24,"tag":33,"props":344,"children":345},{},[346],{"type":30,"value":347},"Availability: Full-time.",{"type":24,"tag":25,"props":349,"children":350},{"id":105},[351],{"type":30,"value":108},{"type":24,"tag":110,"props":353,"children":354},{},[355,360,365,370],{"type":24,"tag":60,"props":356,"children":357},{},[358],{"type":30,"value":359},"Learn and evolve your skills using the latest and greatest technology tools in a rapidly growing company.",{"type":24,"tag":60,"props":361,"children":362},{},[363],{"type":30,"value":364},"Learn from the best people around you. We constantly challenge the status quo and invent new ways of building a great product.",{"type":24,"tag":60,"props":366,"children":367},{},[368],{"type":30,"value":369},"100% remote. Work anywhere, whether it is remotely in the comfort of your home, in a shared co-working space, in an RV on the beach, or while being a nomad in another country.",{"type":24,"tag":60,"props":371,"children":372},{},[373],{"type":30,"value":374},"Work on challenging problems, innovate, and positively impact many people's lives while having fun doing it.",{"type":24,"tag":25,"props":376,"children":377},{"id":135},[378],{"type":30,"value":138},{"type":24,"tag":56,"props":380,"children":381},{},[382,387,392,397,402,407,412,417,422,427,432],{"type":24,"tag":60,"props":383,"children":384},{},[385],{"type":30,"value":386},"Upper-intermediate to fluent speaking and writing English. Able to have a real-time conversation.",{"type":24,"tag":60,"props":388,"children":389},{},[390],{"type":30,"value":391},"3+ years of full-time hands-on Data Analyst / Clinical Terminologyst experience.",{"type":24,"tag":60,"props":393,"children":394},{},[395],{"type":30,"value":396},"3+ years of experience with Medical terminologies (ICD-CM-9/10, SNOMED CT, RxNorm, LOINC, CPT).",{"type":24,"tag":60,"props":398,"children":399},{},[400],{"type":30,"value":401},"3+ years of full-time hands-on Python experience.",{"type":24,"tag":60,"props":403,"children":404},{},[405],{"type":30,"value":406},"3+ years of full-time hands-on SQL experience.",{"type":24,"tag":60,"props":408,"children":409},{},[410],{"type":30,"value":411},"1+ year of full-time hands-on HL7/FHIR experience.",{"type":24,"tag":60,"props":413,"children":414},{},[415],{"type":30,"value":416},"UMLS & NCIm familiarity.",{"type":24,"tag":60,"props":418,"children":419},{},[420],{"type":30,"value":421},"Clinical ontology development/maintenance experience.",{"type":24,"tag":60,"props":423,"children":424},{},[425],{"type":30,"value":426},"Real-world data pipeline work (EHRs, labs, claims, abstraction).",{"type":24,"tag":60,"props":428,"children":429},{},[430],{"type":30,"value":431},"ELT tools, SQL, Python, semantic web stack (RDF, OWL, SPARQL).",{"type":24,"tag":60,"props":433,"children":434},{},[435],{"type":30,"value":436},"HL7/FHIR awareness.",{"type":24,"tag":25,"props":438,"children":439},{"id":164},[440],{"type":30,"value":167},{"type":24,"tag":56,"props":442,"children":443},{},[444,449,454,459,464],{"type":24,"tag":60,"props":445,"children":446},{},[447],{"type":30,"value":448},"Clinical background (PA, NP, RN).",{"type":24,"tag":60,"props":450,"children":451},{},[452],{"type":30,"value":453},"RWD analysis in Python/SQL.",{"type":24,"tag":60,"props":455,"children":456},{},[457],{"type":30,"value":458},"Professional org involvement (OHDSI, AMIA).",{"type":24,"tag":60,"props":460,"children":461},{},[462],{"type":30,"value":463},"OMOP Common Data Model experience.",{"type":24,"tag":60,"props":465,"children":466},{},[467],{"type":30,"value":468},"Bachelor’s degree in Computer Science or equivalent demonstrated ability.",{"type":24,"tag":25,"props":470,"children":471},{"id":183},[472],{"type":30,"value":186},{"type":24,"tag":188,"props":474,"children":475},{},[476],{"type":24,"tag":33,"props":477,"children":478},{},[479],{"type":24,"tag":195,"props":480,"children":481},{},[482],{"type":30,"value":199},{"type":24,"tag":33,"props":484,"children":485},{},[486],{"type":30,"value":487},"The majority of our clients are venture-backed startups at the growth stage. Usually, at this stage, the company already achieved a product-market fit and is looking to expand rapidly. That’s where we bring the best engineering practices, strong architecture, the latest technologies, and consistent processes to help companies scale.",{"type":24,"tag":188,"props":489,"children":490},{},[491],{"type":24,"tag":33,"props":492,"children":493},{},[494],{"type":24,"tag":195,"props":495,"children":496},{},[497],{"type":30,"value":498},"What is the length of your engagements?",{"type":24,"tag":33,"props":500,"children":501},{},[502],{"type":30,"value":503},"Most of our long-term full-time engagements last multiple years. It allows you to evolve your career with the client company taking on more responsibilities.",{"type":24,"tag":188,"props":505,"children":506},{},[507],{"type":24,"tag":33,"props":508,"children":509},{},[510],{"type":24,"tag":195,"props":511,"children":512},{},[513],{"type":30,"value":215},{"type":24,"tag":33,"props":515,"children":516},{},[517],{"type":30,"value":518},"The Right Balance team is 55+ engineers going to 75+ by the end of the year. The current client size team is 410+ people. The timing is great to be a part of a rapidly growing team making meaningful contributions.",{"type":24,"tag":188,"props":520,"children":521},{},[522],{"type":24,"tag":33,"props":523,"children":524},{},[525],{"type":24,"tag":195,"props":526,"children":527},{},[528],{"type":30,"value":529},"What happens if the engagement is completed?",{"type":24,"tag":33,"props":531,"children":532},{},[533],{"type":30,"value":534},"Most of our engagements are long-term in nature. That said, if the current engagement is ramping down, we’ll present you with more long-term opportunities to transition into.",{"type":24,"tag":188,"props":536,"children":537},{},[538],{"type":24,"tag":33,"props":539,"children":540},{},[541],{"type":24,"tag":195,"props":542,"children":543},{},[544],{"type":30,"value":231},{"type":24,"tag":33,"props":546,"children":547},{},[548],{"type":30,"value":236},{"type":24,"tag":33,"props":550,"children":551},{},[552],{"type":30,"value":241},{"type":24,"tag":33,"props":554,"children":555},{},[556],{"type":30,"value":246},{"title":7,"searchDepth":248,"depth":248,"links":558},[559,560,561,562,563,564],{"id":27,"depth":248,"text":31},{"id":286,"depth":248,"text":289},{"id":105,"depth":248,"text":108},{"id":135,"depth":248,"text":138},{"id":164,"depth":248,"text":167},{"id":183,"depth":248,"text":186},"content:opportunities:clinical-terminologist-436.md","opportunities/clinical-terminologist-436.md",{"_path":568,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":569,"description":7,"draft":6,"tags":570,"related_content":571,"short_title":569,"header_one":572,"header_two":573,"header_three":7,"cta_header":14,"cta_button":15,"cta_href":16,"icon":7,"icons":574,"image_url":7,"hero_image":7,"body":576,"_type":257,"_id":852,"_source":259,"_file":853,"_extension":261},"/opportunities/data-modeler-434","Data Modeler - FHIR/OMOP",[10],[],"Data Modeler","FHIR/OMOP",[575,272],"database-cog",{"type":21,"children":577,"toc":844},[578,582,587,591,596,601,605,609,650,654,662,666,685,689,731,735,762,766,776,780,790,794,804,808,818,822,832,836,840],{"type":24,"tag":25,"props":579,"children":580},{"id":27},[581],{"type":30,"value":31},{"type":24,"tag":33,"props":583,"children":584},{},[585],{"type":30,"value":586},"We're looking for a Data Modeler - FHIR/OMOP. Headquartered in Los Angeles, California, Right Balance provides top-tier technology talent for innovative companies in the US. We’re in the top 50 companies to watch in LA.",{"type":24,"tag":25,"props":588,"children":589},{"id":286},[590],{"type":30,"value":289},{"type":24,"tag":33,"props":592,"children":593},{},[594],{"type":30,"value":595},"They're disrupting the clinical trial enrollment process by transforming the way researchers identify eligible patients. Using artificial intelligence and natural language processing to mine structured and unstructured patient data, we find more, better-matching patients for trials in minutes, not months.",{"type":24,"tag":33,"props":597,"children":598},{},[599],{"type":30,"value":600},"They work with some of the most prominent health systems, pharma companies, and CROs in the world, making our platform a crucial step in their clinical research workflow and greatly accelerating patients’ access to clinical trials.",{"type":24,"tag":33,"props":602,"children":603},{},[604],{"type":30,"value":304},{"type":24,"tag":33,"props":606,"children":607},{},[608],{"type":30,"value":309},{"type":24,"tag":56,"props":610,"children":611},{},[612,617,622,627,632,637,642,646],{"type":24,"tag":60,"props":613,"children":614},{},[615],{"type":30,"value":616},"Collaborate with cross-functional teams including medical oncologists, research scientists, and engineers to develop and maintain clinical data models.",{"type":24,"tag":60,"props":618,"children":619},{},[620],{"type":30,"value":621},"Translate customer needs and product requests into key concept definitions and business logic for complex models.",{"type":24,"tag":60,"props":623,"children":624},{},[625],{"type":30,"value":626},"Facilitate integration of data model into workflows, applications, and data deliveries.",{"type":24,"tag":60,"props":628,"children":629},{},[630],{"type":30,"value":631},"Structure and normalize data from a variety of sources, including internal curated data, EHR integrations, and lab systems.",{"type":24,"tag":60,"props":633,"children":634},{},[635],{"type":30,"value":636},"Develop and maintain knowledge bases for clinical concepts.",{"type":24,"tag":60,"props":638,"children":639},{},[640],{"type":30,"value":641},"Create and execute validation plans in conjunction with SMEs for new models and disease types.",{"type":24,"tag":60,"props":643,"children":644},{},[645],{"type":30,"value":337},{"type":24,"tag":60,"props":647,"children":648},{},[649],{"type":30,"value":342},{"type":24,"tag":33,"props":651,"children":652},{},[653],{"type":30,"value":347},{"type":24,"tag":56,"props":655,"children":656},{},[657],{"type":24,"tag":60,"props":658,"children":659},{},[660],{"type":30,"value":661},"6+ months contract (with option to extend).",{"type":24,"tag":25,"props":663,"children":664},{"id":105},[665],{"type":30,"value":108},{"type":24,"tag":110,"props":667,"children":668},{},[669,673,677,681],{"type":24,"tag":60,"props":670,"children":671},{},[672],{"type":30,"value":359},{"ty